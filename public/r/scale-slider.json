{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "scale-slider",
  "title": "Scale Slider",
  "description": "Ui-Layouts component.",
  "dependencies": [
    "embla-carousel",
    "lucide-react",
    "embla-carousel-class-names",
