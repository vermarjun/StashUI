{"name":"swapy","title":"Swapy Layout Primitives","kind":"other","origin":"Ui-Layouts","description":"A set of components wrapping the Swapy library to create draggable dashboard layouts. Includes SwapyLayout container, DragHandle icon, SwapySlot targets, and SwapyItem draggables with configurable animations.","use":"Building dashboard layouts, widget grids, or any interface where users need to reorder content by dragging.","avoid":"Simple lists or tables: this adds complexity for reordering.","a11y":"Uses data attributes for DOM coupling; no explicit keyboard navigation for drag-drop. Focus management depends on wrapped children.","exports":["SwapyLayout","DragHandle","SwapySlot","SwapyItem"],"props":[{"name":"id","type":"string","default":null,"required":true},{"name":"enable","type":"boolean","default":null,"required":false},{"name":"onSwap","type":"(event: { newSlotItemMap: { asArray: SlotItemMapArray } }) => void","default":null,"required":false},{"name":"config","type":"Partial<Config>","default":"{}","required":false},{"name":"className","type":"string","default":null,"required":false},{"name":"children","type":"React.ReactNode","default":null,"required":true}],"npm":["swapy"],"registry":[],"unresolved":[],"colours":3,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport {\n  DragHandle,\n  SwapyItem,\n  SwapyLayout,\n  SwapySlot,\n} from \"@/components/ui/swapy\";\n\nconst config = { animation: \"dynamic\" as const };\n\nfunction Stat({ label, value, note }: { label: string; value: string; note: string }) {\n  return (\n    <div className=\"flex h-full flex-col justify-end p-5\">\n      <p className=\"text-xs text-muted-foreground\">{label}</p>\n      <p className=\"mt-1 text-3xl font-semibold tracking-tight text-foreground\">{value}</p>\n      <p className=\"mt-1 text-xs text-muted-foreground\">{note}</p>\n    </div>\n  );\n}\n\nexport default function Demo() {\n  return (\n    <div className=\"w-full max-w-3xl p-4\">\n      <SwapyLayout id=\"swapy-demo\" config={config} className=\"grid grid-cols-3 gap-3\">\n        <SwapySlot id=\"a\" className=\"col-span-2 h-48 rounded-xl\">\n          <SwapyItem id=\"item-a\" className=\"relative h-full overflow-hidden rounded-xl border border-border bg-card\">\n            <DragHandle />\n            <img\n              src=\"https://images.unsplash.com/photo-1689229799782-b96891a0aa0d?w=800&h=400&fit=crop&auto=format&q=80\"\n              alt=\"\"\n              className=\"absolute inset-0 h-full w-full object-cover opacity-80\"\n            />\n            <div className=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-5\">\n              <p className=\"text-lg font-semibold text-white\">Summer campaign</p>\n              <p className=\"text-xs text-white/70\">Drag any card by its handle</p>\n            </div>\n          </SwapyItem>\n        </SwapySlot>\n        <SwapySlot id=\"b\" className=\"h-48 rounded-xl\">\n          <SwapyItem id=\"item-b\" className=\"relative h-full rounded-xl border border-border bg-card\">\n            <DragHandle />\n            <Stat label=\"Revenue\" value=\"$48.2k\" note=\"+12% this month\" />\n          </SwapyItem>\n        </SwapySlot>\n        <SwapySlot id=\"c\" className=\"h-48 rounded-xl\">\n          <SwapyItem id=\"item-c\" className=\"relative h-full rounded-xl border border-border bg-card\">\n            <DragHandle />\n            <Stat label=\"Subscribers\" value=\"3,912\" note=\"+284 new\" />\n          </SwapyItem>\n        </SwapySlot>\n        <SwapySlot id=\"d\" className=\"h-48 rounded-xl\">\n          <SwapyItem id=\"item-d\" className=\"relative h-full rounded-xl border border-border bg-foreground\">\n            <DragHandle className=\"text-background/60\" />\n            <div className=\"flex h-full flex-col justify-end p-5\">\n              <p className=\"text-xs text-background/60\">Conversion</p>\n              <p className=\"mt-1 text-3xl font-semibold tracking-tight text-background\">4.7%</p>\n              <p className=\"mt-1 text-xs text-background/60\">Best week yet</p>\n            </div>\n          </SwapyItem>\n        </SwapySlot>\n        <SwapySlot id=\"e\" className=\"h-48 rounded-xl\">\n          <SwapyItem id=\"item-e\" className=\"relative h-full overflow-hidden rounded-xl border border-border bg-card\">\n            <DragHandle />\n            <img\n              src=\"https://images.unsplash.com/photo-1605106250963-ffda6d2a4b32?w=400&h=400&fit=crop&auto=format&q=80\"\n              alt=\"\"\n              className=\"absolute inset-0 h-full w-full object-cover opacity-80\"\n            />\n          </SwapyItem>\n        </SwapySlot>\n      </SwapyLayout>\n    </div>\n  );\n}","file":"components/ui/swapy.tsx","registryItem":"https://stashui.vermarjun.xyz/r/swapy.json","live":"https://stashui.vermarjun.xyz/c/swapy"}