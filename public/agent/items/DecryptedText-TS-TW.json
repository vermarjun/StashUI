{"name":"DecryptedText-TS-TW","title":"Decrypted Text","kind":"text-effect","origin":"React Bits","description":"Renders text as scrambled characters and progressively reveals the readable text character by character or randomly. Trigger modes: hover, scroll visibility, or click; can reverse back to encrypted.","use":"A reveal animation that wants to intrigue or disguise content until the user interacts.","avoid":"When the content must be immediately readable for SEO or accessibility compliance.","a11y":"Encrypted text is shown visually but hidden with aria-hidden; readable text is in sr-only for screen readers. Works correctly when decrypted.","exports":["DecryptedText"],"props":[{"name":"text","type":"string","default":null,"required":true},{"name":"speed","type":"number","default":"50","required":false},{"name":"maxIterations","type":"number","default":"10","required":false},{"name":"sequential","type":"boolean","default":"false","required":false},{"name":"revealDirection","type":"'start' | 'end' | 'center'","default":"'start'","required":false},{"name":"useOriginalCharsOnly","type":"boolean","default":"false","required":false},{"name":"characters","type":"string","default":"'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!@#$%^&","required":false},{"name":"className","type":"string","default":"''","required":false},{"name":"encryptedClassName","type":"string","default":"''","required":false},{"name":"parentClassName","type":"string","default":"''","required":false},{"name":"animateOn","type":"'view' | 'hover' | 'inViewHover' | 'click'","default":"'hover'","required":false},{"name":"clickMode","type":"'once' | 'toggle'","default":"'once'","required":false}],"npm":["motion@^12.23.12"],"registry":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport DecryptedText from \"@/components/ui/DecryptedText\"\n\nexport default function Demo() {\n  return (\n    <div className=\"flex flex-col items-center justify-center gap-8 p-12 min-h-[200px]\">\n      <DecryptedText\n        text=\"Hover over me to decrypt!\"\n        animateOn=\"hover\"\n        speed={50}\n        maxIterations={10}\n        sequential\n        className=\"text-2xl font-bold text-green-500\"\n        encryptedClassName=\"text-2xl font-bold text-gray-400\"\n      />\n      <DecryptedText\n        text=\"Decrypted on view trigger\"\n        animateOn=\"view\"\n        speed={40}\n        maxIterations={12}\n        sequential\n        revealDirection=\"center\"\n        className=\"text-xl font-mono text-blue-500\"\n        encryptedClassName=\"text-xl font-mono text-gray-300\"\n      />\n      <DecryptedText\n        text=\"Click me to reveal the message\"\n        animateOn=\"click\"\n        clickMode=\"toggle\"\n        speed={60}\n        maxIterations={8}\n        className=\"text-lg font-semibold text-purple-500 cursor-pointer\"\n        encryptedClassName=\"text-lg font-semibold text-gray-400 cursor-pointer\"\n      />\n    </div>\n  )\n}","file":"components/ui/DecryptedText-TS-TW.tsx","registryItem":"https://stashui.vermarjun.xyz/r/DecryptedText-TS-TW.json","live":"https://stashui.vermarjun.xyz/c/DecryptedText-TS-TW"}