{"name":"dropdown-menu","title":"Dropdown Menu","kind":"dropdown-menu","origin":"Origin UI","description":"A set of Radix UI dropdown menu primitives including root, trigger, content, items, groups, separators, checkboxes, radio groups, and submenus with keyboard and mouse support.","use":"Building custom dropdown menus with radix-ui primitives.","avoid":"Simple one-off menus where a ready-made dropdown suffices.","a11y":"Full ARIA support from Radix UI including keyboard navigation.","exports":["DropdownMenu","DropdownMenuCheckboxItem","DropdownMenuContent","DropdownMenuGroup","DropdownMenuItem","DropdownMenuLabel","DropdownMenuPortal","DropdownMenuRadioGroup","DropdownMenuRadioItem","DropdownMenuSeparator","DropdownMenuShortcut","DropdownMenuSub","DropdownMenuSubContent","DropdownMenuSubTrigger","DropdownMenuTrigger"],"props":[],"npm":["radix-ui"],"registry":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport {\n  CreditCardIcon,\n  KeyboardIcon,\n  LogOutIcon,\n  SettingsIcon,\n  UserIcon,\n  UsersIcon,\n} from \"lucide-react\";\nimport { useState } from \"react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport {\n  DropdownMenu,\n  DropdownMenuCheckboxItem,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\n\nexport default function Demo() {\n  const [showStatusBar, setShowStatusBar] = useState(true);\n\n  return (\n    <div className=\"flex min-h-[480px] w-full items-center justify-center\">\n      <DropdownMenu>\n        <DropdownMenuTrigger asChild>\n          <Button variant=\"outline\">Open menu</Button>\n        </DropdownMenuTrigger>\n        <DropdownMenuContent className=\"w-56\">\n          <DropdownMenuLabel>My account</DropdownMenuLabel>\n          <DropdownMenuSeparator />\n          <DropdownMenuGroup>\n            <DropdownMenuItem>\n              <UserIcon aria-hidden=\"true\" className=\"opacity-60\" size={16} />\n              Profile\n              <DropdownMenuShortcut>⇧⌘P</DropdownMenuShortcut>\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <CreditCardIcon\n                aria-hidden=\"true\"\n                className=\"opacity-60\"\n                size={16}\n              />\n              Billing\n              <DropdownMenuShortcut>⌘B</DropdownMenuShortcut>\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <SettingsIcon\n                aria-hidden=\"true\"\n                className=\"opacity-60\"\n                size={16}\n              />\n              Settings\n              <DropdownMenuShortcut>⌘S</DropdownMenuShortcut>\n            </DropdownMenuItem>\n            <DropdownMenuItem>\n              <KeyboardIcon\n                aria-hidden=\"true\"\n                className=\"opacity-60\"\n                size={16}\n              />\n              Keyboard shortcuts\n            </DropdownMenuItem>\n          </DropdownMenuGroup>\n          <DropdownMenuSeparator />\n          <DropdownMenuCheckboxItem\n            checked={showStatusBar}\n            onCheckedChange={setShowStatusBar}\n          >\n            Show status bar\n          </DropdownMenuCheckboxItem>\n          <DropdownMenuItem>\n            <UsersIcon aria-hidden=\"true\" className=\"opacity-60\" size={16} />\n            Team\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem>\n            <LogOutIcon aria-hidden=\"true\" className=\"opacity-60\" size={16} />\n            Log out\n            <DropdownMenuShortcut>⇧⌘Q</DropdownMenuShortcut>\n          </DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </div>\n  );\n}","file":"components/ui/dropdown-menu.tsx","registryItem":"https://stashui.vermarjun.xyz/r/dropdown-menu.json","live":"https://stashui.vermarjun.xyz/c/dropdown-menu"}