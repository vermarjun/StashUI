{"name":"dialog-stack","title":"Dialog Stack","kind":"modal","origin":"Kibo UI","description":"Layered dialogs where an invite-team step stacks over a dimmed previous dialog.","use":"Multi-step flows that stack dialogs on top of each other.","avoid":"","a11y":"","exports":["DialogStack","DialogStackTrigger","DialogStackOverlay","DialogStackBody","DialogStackContent","DialogStackTitle","DialogStackDescription","DialogStackHeader","DialogStackFooter","DialogStackNext","DialogStackPrevious"],"props":[],"npm":["@radix-ui/react-use-controllable-state","radix-ui"],"registry":[],"colours":1,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  DialogStack,\n  DialogStackBody,\n  DialogStackContent,\n  DialogStackDescription,\n  DialogStackFooter,\n  DialogStackHeader,\n  DialogStackNext,\n  DialogStackOverlay,\n  DialogStackPrevious,\n  DialogStackTitle,\n  DialogStackTrigger,\n} from \"./dialog-stack\";\n\nconst teammates = [\n  { name: \"Maya Chen\", email: \"maya@northwind.dev\", img: 47 },\n  { name: \"Leo Park\", email: \"leo@northwind.dev\", img: 12 },\n  { name: \"Priya Nair\", email: \"priya@northwind.dev\", img: 32 },\n];\n\nconst plans = [\n  { name: \"Starter\", price: \"$0\", note: \"Up to 3 members\" },\n  { name: \"Team\", price: \"$12\", note: \"per member / month\" },\n  { name: \"Business\", price: \"$29\", note: \"SSO, audit log, SLA\" },\n];\n\nexport default function DialogStackDemo() {\n  return (\n    <div className=\"flex min-h-[560px] w-full items-center justify-center\">\n      <DialogStack clickable>\n        <DialogStackTrigger asChild>\n          <Button variant=\"outline\">Create workspace</Button>\n        </DialogStackTrigger>\n        <DialogStackOverlay />\n        <DialogStackBody>\n          <DialogStackContent>\n            <DialogStackHeader>\n              <DialogStackTitle>Name your workspace</DialogStackTitle>\n              <DialogStackDescription>\n                Step 1 of 3. You can change this later in settings.\n              </DialogStackDescription>\n            </DialogStackHeader>\n            <div className=\"mt-4 grid gap-2\">\n              <Label htmlFor=\"ws-name\">Workspace name</Label>\n              <Input defaultValue=\"Northwind Design\" id=\"ws-name\" />\n              <p className=\"text-muted-foreground text-xs\">\n                stashui.app/northwind-design\n              </p>\n            </div>\n            <DialogStackFooter className=\"mt-6 justify-end\">\n              <DialogStackNext asChild>\n                <Button>Continue</Button>\n              </DialogStackNext>\n            </DialogStackFooter>\n          </DialogStackContent>\n\n          <DialogStackContent>\n            <DialogStackHeader>\n              <DialogStackTitle>Invite your team</DialogStackTitle>\n              <DialogStackDescription>\n                Step 2 of 3. They will get an email invite.\n              </DialogStackDescription>\n            </DialogStackHeader>\n            <ul className=\"mt-4 space-y-3\">\n              {teammates.map((t) => (\n                <li className=\"flex items-center gap-3\" key={t.email}>\n                  <img\n                    alt={t.name}\n                    className=\"size-8 rounded-full\"\n                    src={`https://i.pravatar.cc/150?img=${t.img}`}\n                  />\n                  <div className=\"flex-1 text-sm\">\n                    <p className=\"font-medium\">{t.name}</p>\n                    <p className=\"text-muted-foreground text-xs\">{t.email}</p>\n                  </div>\n                  <span className=\"text-muted-foreground text-xs\">Editor</span>\n                </li>\n              ))}\n            </ul>\n            <DialogStackFooter className=\"mt-6 justify-between\">\n              <DialogStackPrevious asChild>\n                <Button variant=\"ghost\">Back</Button>\n              </DialogStackPrevious>\n              <DialogStackNext asChild>\n                <Button>Send invites</Button>\n              </DialogStackNext>\n            </DialogStackFooter>\n          </DialogStackContent>\n\n          <DialogStackContent>\n            <DialogStackHeader>\n              <DialogStackTitle>Choose a plan</DialogStackTitle>\n              <DialogStackDescription>\n                Step 3 of 3. 14-day free trial on paid plans.\n              </DialogStackDescription>\n            </DialogStackHeader>\n            <div className=\"mt-4 grid grid-cols-3 gap-2\">\n              {plans.map((p, i) => (\n                <div\n                  className={\n                    i === 1\n                      ? \"rounded-lg border border-foreground p-3\"\n                      : \"rounded-lg border p-3\"\n                  }\n                  key={p.name}\n                >\n                  <p className=\"font-medium text-sm\">{p.name}</p>\n                  <p className=\"mt-1 font-semibold text-xl\">{p.price}</p>\n                  <p className=\"text-muted-foreground text-xs\">{p.note}</p>\n                </div>\n              ))}\n            </div>\n            <DialogStackFooter className=\"mt-6 justify-between\">\n              <DialogStackPrevious asChild>\n                <Button variant=\"ghost\">Back</Button>\n              </DialogStackPrevious>\n              <Button>Start trial</Button>\n            </DialogStackFooter>\n          </DialogStackContent>\n        </DialogStackBody>\n      </DialogStack>\n    </div>\n  );\n}","file":"components/ui/dialog-stack.tsx","registryItem":"https://stashui.vermarjun.xyz/r/dialog-stack.json","live":"https://stashui.vermarjun.xyz/c/dialog-stack"}