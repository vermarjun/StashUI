{"name":"terminal-animation","title":"Terminal Animation","kind":"code-block","origin":"Cult UI","description":"Tabs trigger animation: command types character-by-character, output lines appear in sequence with delays. Optionally slides up on scroll into view. Uses React Context to coordinate child components.","use":"Hero sections or docs demonstrating CLI workflows with interactive tab switching.","avoid":"When animation must pause/resume or loop indefinitely; animation runs once per tab on mount.","a11y":"Output has aria-live='polite' for screen readers. No prefers-reduced-motion handling. Tab list has role='tablist'.","exports":["TerminalAnimationRoot","TerminalAnimationBackgroundGradient","TerminalAnimationContainer","TerminalAnimationWindow","TerminalAnimationContent","TerminalAnimationBlinkingCursor","TerminalAnimationCommandBar","TerminalAnimationOutputLine","TerminalAnimationOutput","TerminalAnimationTrailingPrompt","TerminalAnimationTabList","TerminalAnimationTabTrigger"],"props":[{"name":"tabs","type":"TabContent[]","default":null,"required":true},{"name":"defaultActiveTab","type":"number","default":"0","required":false},{"name":"activeTab","type":"number","default":null,"required":false},{"name":"onActiveTabChange","type":"(index: number) => void","default":null,"required":false},{"name":"backgroundImage","type":"string","default":null,"required":false},{"name":"alwaysDark","type":"boolean","default":"false","required":false},{"name":"hideCursorOnComplete","type":"boolean","default":"true","required":false},{"name":"className","type":"string","default":"{cn(alwaysDark && \"dark\", className)}","required":false},{"name":"children","type":"React.ReactNode","default":null,"required":false}],"npm":["@radix-ui/react-slot","@radix-ui/react-use-controllable-state"],"registry":[],"colours":55,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport {\n  TerminalAnimationBackgroundGradient,\n  TerminalAnimationBlinkingCursor,\n  TerminalAnimationCommandBar,\n  TerminalAnimationContainer,\n  TerminalAnimationContent,\n  TerminalAnimationOutput,\n  TerminalAnimationRoot,\n  TerminalAnimationTabList,\n  TerminalAnimationTabTrigger,\n  TerminalAnimationWindow,\n  defaultTerminalTabs,\n} from \"@/components/ui/terminal-animation\"\n\nexport default function Demo() {\n  return (\n    <TerminalAnimationRoot\n      tabs={defaultTerminalTabs}\n      alwaysDark\n      className=\"relative flex h-[620px] w-full justify-center overflow-hidden\"\n    >\n      <TerminalAnimationBackgroundGradient />\n      <TerminalAnimationContainer className=\"relative flex max-w-3xl justify-center px-6 pt-14 md:pt-16\">\n        <TerminalAnimationWindow\n          minHeight=\"34rem\"\n          className=\"w-full rounded-xl border border-white/10 bg-zinc-950/95 font-mono text-[15px] text-zinc-100 shadow-2xl shadow-black/60 ring-1 ring-black/40 backdrop-blur\"\n        >\n          <div className=\"flex items-center gap-4 border-white/10 border-b px-4 pt-3\">\n            <div className=\"flex gap-1.5 pb-3\">\n              <span className=\"size-3 rounded-full bg-[#ff5f57]\" />\n              <span className=\"size-3 rounded-full bg-[#febc2e]\" />\n              <span className=\"size-3 rounded-full bg-[#28c840]\" />\n            </div>\n            <TerminalAnimationTabList className=\"flex gap-1\">\n              {defaultTerminalTabs.map((tab, i) => (\n                <TerminalAnimationTabTrigger\n                  key={tab.label}\n                  index={i}\n                  className=\"rounded-t-md px-3 py-2 text-sm text-zinc-400 transition-colors hover:text-zinc-100 data-[state=active]:bg-zinc-800 data-[state=active]:text-white\"\n                >\n                  {tab.label}\n                </TerminalAnimationTabTrigger>\n              ))}\n            </TerminalAnimationTabList>\n          </div>\n          <TerminalAnimationContent>\n            <div className=\"mb-3 flex items-center text-zinc-100\">\n              <span className=\"mr-2 text-emerald-400\">$</span>\n              <TerminalAnimationCommandBar />\n              <TerminalAnimationBlinkingCursor />\n            </div>\n            <TerminalAnimationOutput\n              renderLine={(line, _index, visible) => {\n                if (!visible) return null\n                return (\n                  <div className={`whitespace-pre leading-relaxed ${line.color ?? \"text-zinc-200\"}`}>\n                    {line.text || \" \"}\n                  </div>\n                )\n              }}\n            />\n          </TerminalAnimationContent>\n        </TerminalAnimationWindow>\n      </TerminalAnimationContainer>\n    </TerminalAnimationRoot>\n  )\n}","file":"components/ui/terminal-animation.tsx","registryItem":"https://stashui.vermarjun.xyz/r/terminal-animation.json","live":"https://stashui.vermarjun.xyz/c/terminal-animation"}