{"name":"button-group","title":"Button Group","kind":"button","origin":"shadcn/ui","description":"Grouped toolbar controls: archive and star actions, formatting, URL field, quantity stepper.","use":"Joined buttons, toolbars and compound controls.","avoid":"","a11y":"","exports":["ButtonGroup","ButtonGroupSeparator","ButtonGroupText"],"props":[],"npm":["class-variance-authority","radix-ui"],"registry":["button","separator"],"unresolved":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport * as React from \"react\"\nimport {\n  AlignCenterIcon,\n  AlignLeftIcon,\n  AlignRightIcon,\n  ArchiveIcon,\n  ArrowLeftIcon,\n  BoldIcon,\n  ChevronDownIcon,\n  ItalicIcon,\n  MinusIcon,\n  PlusIcon,\n  SearchIcon,\n  ShareIcon,\n  StarIcon,\n  UnderlineIcon,\n} from \"lucide-react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Input } from \"@/components/ui/input\"\n\nimport { ButtonGroup, ButtonGroupSeparator, ButtonGroupText } from \"./button-group\"\n\nexport default function ButtonGroupDemo() {\n  const [qty, setQty] = React.useState(2)\n  const [align, setAlign] = React.useState(\"left\")\n  const [marks, setMarks] = React.useState<string[]>([\"bold\"])\n  const toggle = (m: string) =>\n    setMarks((p) => (p.includes(m) ? p.filter((x) => x !== m) : [...p, m]))\n\n  return (\n    <div className=\"flex h-full min-h-[480px] w-full items-center justify-center p-6\">\n      <div className=\"flex w-full max-w-lg flex-col items-center gap-6\">\n        <ButtonGroup aria-label=\"Message actions\">\n          <ButtonGroup>\n            <Button variant=\"outline\" size=\"icon\" aria-label=\"Back\">\n              <ArrowLeftIcon />\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup>\n            <Button variant=\"outline\">\n              <ArchiveIcon /> Archive\n            </Button>\n            <Button variant=\"outline\">Snooze</Button>\n          </ButtonGroup>\n          <ButtonGroup>\n            <Button variant=\"outline\">\n              <StarIcon /> Star\n            </Button>\n            <Button variant=\"outline\" size=\"icon\" aria-label=\"More\">\n              <ChevronDownIcon />\n            </Button>\n          </ButtonGroup>\n        </ButtonGroup>\n\n        <div className=\"flex gap-3\">\n          <ButtonGroup aria-label=\"Text style\">\n            {[\n              [\"bold\", BoldIcon],\n              [\"italic\", ItalicIcon],\n              [\"underline\", UnderlineIcon],\n            ].map(([m, Icon]) => {\n              const I = Icon as typeof BoldIcon\n              const on = marks.includes(m as string)\n              return (\n                <Button\n                  key={m as string}\n                  variant={on ? \"secondary\" : \"outline\"}\n                  size=\"icon\"\n                  aria-label={m as string}\n                  aria-pressed={on}\n                  onClick={() => toggle(m as string)}\n                >\n                  <I />\n                </Button>\n              )\n            })}\n          </ButtonGroup>\n          <ButtonGroup aria-label=\"Alignment\">\n            {[\n              [\"left\", AlignLeftIcon],\n              [\"center\", AlignCenterIcon],\n              [\"right\", AlignRightIcon],\n            ].map(([a, Icon]) => {\n              const I = Icon as typeof AlignLeftIcon\n              return (\n                <Button\n                  key={a as string}\n                  variant={align === a ? \"secondary\" : \"outline\"}\n                  size=\"icon\"\n                  aria-label={`Align ${a}`}\n                  onClick={() => setAlign(a as string)}\n                >\n                  <I />\n                </Button>\n              )\n            })}\n          </ButtonGroup>\n        </div>\n\n        <ButtonGroup className=\"w-full max-w-sm\">\n          <ButtonGroupText>https://</ButtonGroupText>\n          <Input placeholder=\"stashui.dev/components\" />\n          <Button variant=\"outline\" aria-label=\"Search\">\n            <SearchIcon />\n          </Button>\n        </ButtonGroup>\n\n        <div className=\"flex items-center gap-3\">\n          <ButtonGroup aria-label=\"Quantity\">\n            <Button\n              variant=\"outline\"\n              size=\"icon\"\n              aria-label=\"Decrease\"\n              onClick={() => setQty((q) => Math.max(0, q - 1))}\n            >\n              <MinusIcon />\n            </Button>\n            <ButtonGroupText className=\"min-w-12 justify-center tabular-nums\">\n              {qty}\n            </ButtonGroupText>\n            <Button\n              variant=\"outline\"\n              size=\"icon\"\n              aria-label=\"Increase\"\n              onClick={() => setQty((q) => q + 1)}\n            >\n              <PlusIcon />\n            </Button>\n          </ButtonGroup>\n          <ButtonGroup>\n            <Button>Add to cart</Button>\n            <ButtonGroupSeparator className=\"bg-primary-foreground/30\" />\n            <Button size=\"icon\" aria-label=\"Share\">\n              <ShareIcon />\n            </Button>\n          </ButtonGroup>\n        </div>\n      </div>\n    </div>\n  )\n}","file":"components/ui/button-group.tsx","registryItem":"https://stashui.vermarjun.xyz/r/button-group.json","live":"https://stashui.vermarjun.xyz/c/button-group"}