{"name":"select","title":"Select","kind":"select","origin":"Origin UI","description":"Radix Select primitive wrapper with support for item groups, labels, separators, and scroll controls on open.","use":"A native-feeling dropdown select where single choice from many is needed.","avoid":"Uncontrolled usage without managing form state.","a11y":"Full ARIA support via Radix. Keyboard arrow navigation, Enter to select, Escape to close.","exports":["Select","SelectContent","SelectGroup","SelectItem","SelectLabel","SelectScrollDownButton","SelectScrollUpButton","SelectSeparator","SelectTrigger","SelectValue"],"props":[{"name":"value","type":"string","default":null,"required":false}],"npm":["radix-ui"],"registry":[],"unresolved":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectLabel,\n  SelectSeparator,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\n\nexport default function Demo() {\n  return (\n    <div className=\"flex min-h-[480px] w-full items-center justify-center px-6\">\n      <div className=\"flex w-full max-w-2xl gap-8\">\n        <div className=\"w-full max-w-xs space-y-4 rounded-xl border border-border bg-card p-6 shadow-sm\">\n          <p className=\"font-medium text-foreground text-sm\">New project</p>\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"framework\">Framework</Label>\n            <Select defaultValue=\"next\">\n              <SelectTrigger className=\"w-full\" id=\"framework\">\n                <SelectValue placeholder=\"Select a framework\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"next\">Next.js</SelectItem>\n                <SelectItem value=\"remix\">Remix</SelectItem>\n                <SelectItem value=\"astro\">Astro</SelectItem>\n                <SelectItem value=\"vite\">Vite</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"region\">Region</Label>\n            <Select defaultValue=\"fra\">\n              <SelectTrigger className=\"w-full\" id=\"region\">\n                <SelectValue placeholder=\"Select a region\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"iad\">Washington, D.C.</SelectItem>\n                <SelectItem value=\"fra\">Frankfurt</SelectItem>\n                <SelectItem value=\"sin\">Singapore</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        </div>\n        <div className=\"w-full max-w-xs space-y-2 pt-6\">\n          <Label htmlFor=\"timezone\">Timezone</Label>\n          <Select defaultValue=\"cet\">\n            <SelectTrigger className=\"w-full\" id=\"timezone\">\n              <SelectValue placeholder=\"Select a timezone\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectGroup>\n                <SelectLabel>Europe</SelectLabel>\n                <SelectItem value=\"gmt\">Greenwich Mean Time</SelectItem>\n                <SelectItem value=\"cet\">Central European Time</SelectItem>\n                <SelectItem value=\"eet\">Eastern European Time</SelectItem>\n              </SelectGroup>\n              <SelectSeparator />\n              <SelectGroup>\n                <SelectLabel>Asia</SelectLabel>\n                <SelectItem value=\"ist\">India Standard Time</SelectItem>\n                <SelectItem value=\"jst\">Japan Standard Time</SelectItem>\n              </SelectGroup>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n    </div>\n  );\n}","file":"components/ui/select.tsx","registryItem":"https://stashui.vermarjun.xyz/r/select.json","live":"https://stashui.vermarjun.xyz/c/select"}