{"name":"toggle-group","title":"Toggle Group","kind":"editor","origin":"Origin UI","description":"Toggle group built on Radix UI for managing multiple toggles with shared styling. Supports single or multiple selection via type prop. ToggleGroupItem respects parent size and variant.","use":"Toolbar groups for bold, italic and alignment options.","avoid":"When you need mutually exclusive radio buttons. Use RadioGroup for that.","a11y":"Built on Radix UI ToggleGroup with proper aria-pressed handling and focus management across items.","exports":["ToggleGroup","ToggleGroupItem"],"props":[{"name":"size","type":"'default' | 'lg' | 'sm'","default":"default","required":false},{"name":"variant","type":"'default' | 'outline'","default":"default","required":false},{"name":"type","type":"'single' | 'multiple'","default":null,"required":false}],"npm":["radix-ui"],"registry":["toggle"],"unresolved":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport { useState } from \"react\";\nimport {\n  AlignCenterIcon,\n  AlignLeftIcon,\n  AlignRightIcon,\n  BoldIcon,\n  ItalicIcon,\n  UnderlineIcon,\n} from \"lucide-react\";\n\nimport { cn } from \"@/lib/utils\";\nimport { ToggleGroup, ToggleGroupItem } from \"@/components/ui/toggle-group\";\n\nexport default function Demo() {\n  const [marks, setMarks] = useState<string[]>([\"bold\"]);\n  const [align, setAlign] = useState(\"left\");\n\n  return (\n    <div className=\"flex min-h-[420px] w-full items-center justify-center p-8\">\n      <div className=\"w-full max-w-xl rounded-xl border border-border bg-card text-card-foreground shadow-sm\">\n        <div className=\"flex items-center gap-3 border-b border-border p-2\">\n          <ToggleGroup\n            type=\"multiple\"\n            variant=\"outline\"\n            value={marks}\n            onValueChange={setMarks}\n            aria-label=\"Text formatting\"\n          >\n            <ToggleGroupItem value=\"bold\" aria-label=\"Bold\">\n              <BoldIcon className=\"size-4\" />\n            </ToggleGroupItem>\n            <ToggleGroupItem value=\"italic\" aria-label=\"Italic\">\n              <ItalicIcon className=\"size-4\" />\n            </ToggleGroupItem>\n            <ToggleGroupItem value=\"underline\" aria-label=\"Underline\">\n              <UnderlineIcon className=\"size-4\" />\n            </ToggleGroupItem>\n          </ToggleGroup>\n          <span className=\"h-6 w-px bg-border\" />\n          <ToggleGroup\n            type=\"single\"\n            variant=\"outline\"\n            value={align}\n            onValueChange={(v) => v && setAlign(v)}\n            aria-label=\"Text alignment\"\n          >\n            <ToggleGroupItem value=\"left\" aria-label=\"Left align\">\n              <AlignLeftIcon className=\"size-4\" />\n            </ToggleGroupItem>\n            <ToggleGroupItem value=\"center\" aria-label=\"Center align\">\n              <AlignCenterIcon className=\"size-4\" />\n            </ToggleGroupItem>\n            <ToggleGroupItem value=\"right\" aria-label=\"Right align\">\n              <AlignRightIcon className=\"size-4\" />\n            </ToggleGroupItem>\n          </ToggleGroup>\n        </div>\n        <div\n          className={cn(\n            \"space-y-3 p-6 leading-relaxed transition-all\",\n            align === \"center\" && \"text-center\",\n            align === \"right\" && \"text-right\",\n          )}\n        >\n          <p\n            className={cn(\n              \"text-lg text-foreground\",\n              marks.includes(\"bold\") && \"font-bold\",\n              marks.includes(\"italic\") && \"italic\",\n              marks.includes(\"underline\") && \"underline underline-offset-4\",\n            )}\n          >\n            Release notes, v2.4\n          </p>\n          <p className=\"text-sm text-muted-foreground\">\n            Offline drafts now sync the moment you reconnect, and conflicts are merged line by line instead of\n            asking you to pick a version.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}","file":"components/ui/toggle-group.tsx","registryItem":"https://stashui.vermarjun.xyz/r/toggle-group.json","live":"https://stashui.vermarjun.xyz/c/toggle-group"}