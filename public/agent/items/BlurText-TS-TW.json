{"name":"BlurText-TS-TW","title":"Blur Text","kind":"text-effect","origin":"React Bits","description":"Wraps text and staggered-animates each word (or letter) to fade in and blur-out with configurable easing. Triggered by scroll visibility via IntersectionObserver.","use":"Body copy or headings need a polished reveal entrance as the page scrolls.","avoid":"When prefers-reduced-motion is set: the animation continues regardless.","a11y":"Text content is fully readable; uses motion/react for animation. No motion guard; runs for all users.","exports":["BlurText"],"props":[{"name":"text","type":"string","default":"''","required":false},{"name":"delay","type":"number","default":"200","required":false},{"name":"className","type":"string","default":"''","required":false},{"name":"animateBy","type":"'words' | 'letters'","default":"'words'","required":false},{"name":"direction","type":"'top' | 'bottom'","default":"'top'","required":false},{"name":"threshold","type":"number","default":"0.1","required":false},{"name":"rootMargin","type":"string","default":"'0px'","required":false},{"name":"animationFrom","type":"Record<string, string | number>","default":null,"required":false},{"name":"animationTo","type":"Array<Record<string, string | number>>","default":null,"required":false},{"name":"easing","type":"Easing | Easing[]","default":"(t: number) => t","required":false},{"name":"onAnimationComplete","type":"() => void","default":"{index === elements.length - 1 ? onAnimationComplete : undef","required":false},{"name":"stepDuration","type":"number","default":"0.35","required":false}],"npm":["motion@^12.23.12"],"registry":[],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport { useState } from \"react\"\nimport { RotateCcw } from \"lucide-react\"\nimport BlurText from \"@/components/ui/BlurText\"\n\nexport default function Demo() {\n  const [run, setRun] = useState(0)\n\n  return (\n    <div className=\"relative flex min-h-[380px] w-full flex-col items-center justify-center gap-6 p-12\">\n      <div key={run} className=\"flex flex-col items-center gap-6\">\n        <BlurText\n          text=\"Design systems built to last\"\n          animateBy=\"words\"\n          direction=\"top\"\n          delay={150}\n          className=\"justify-center text-5xl font-bold tracking-tight text-foreground\"\n        />\n        <BlurText\n          text=\"Composable. Accessible. Beautiful.\"\n          animateBy=\"words\"\n          direction=\"bottom\"\n          delay={120}\n          stepDuration={0.4}\n          className=\"justify-center text-2xl font-medium text-muted-foreground\"\n        />\n      </div>\n      <button\n        type=\"button\"\n        onClick={() => setRun((n) => n + 1)}\n        className=\"absolute right-4 bottom-4 inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground\"\n      >\n        <RotateCcw className=\"size-3.5\" />\n        Replay\n      </button>\n    </div>\n  )\n}","file":"components/ui/BlurText-TS-TW.tsx","registryItem":"https://stashui.vermarjun.xyz/r/BlurText-TS-TW.json","live":"https://stashui.vermarjun.xyz/c/BlurText-TS-TW"}