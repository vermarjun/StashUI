{"name":"onboarding","title":"Onboarding","kind":"onboarding","origin":"Cult UI","description":"Composable onboarding system with StepIndicator, ChoiceGroup, FeatureCarousel, TipsList, and Onboarding context. Supports both dots and pills progress variants, controlled and uncontrolled modes, and state callbacks for step navigation.","use":"Building product walkthroughs, setup wizards, or feature tours that guide new users through sequential steps with…","avoid":"Simple single-screen flows. Not ideal when steps can be skipped or accessed non-sequentially.","a11y":"Keyboard navigation for step transitions. Proper ARIA attributes on progress indicator. Role and live region support via composition.","exports":["StepIndicator","ChoiceGroup","FeatureCarousel","TipsList","Onboarding"],"props":[{"name":"currentStep","type":"number","default":"{currentStep}","required":true},{"name":"totalSteps","type":"number","default":"{totalSteps}","required":true},{"name":"variant","type":"'dots' | 'pills'","default":"\"dots\"","required":false}],"npm":["@radix-ui/react-use-controllable-state","class-variance-authority"],"registry":["button"],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport { Onboarding } from \"@/components/ui/onboarding\"\n\nexport default function Demo() {\n  return (\n    <div className=\"flex items-center justify-center w-full min-h-[420px] p-6 bg-background\">\n      <Onboarding totalSteps={3} defaultValue={1} className=\"w-full max-w-sm\">\n        <Onboarding.StepIndicator className=\"mb-6 justify-center\" />\n\n        <Onboarding.Step step={1}>\n          <Onboarding.Header\n            title=\"Welcome to StashUI\"\n            description=\"A personal component library built for speed and aesthetics.\"\n          />\n          <div className=\"mt-4 rounded-lg border border-border bg-muted/40 p-4 text-sm text-muted-foreground\">\n            Browse, preview, and install polished components directly into your\n     