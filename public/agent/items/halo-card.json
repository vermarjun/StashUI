{"name":"halo-card","title":"Halo Card","kind":"modal","origin":"Cult UI","description":"Invite-your-team dialog card listing members with roles, glowing halo edge and send button.","use":"Team invite or member management dialog.","avoid":"","a11y":"","exports":["HaloCard","HaloCardAction","HaloCardButton","HaloCardContent","HaloCardDescription","HaloCardFooter","HaloCardHeader","HaloCardTitle"],"props":[],"npm":["motion"],"registry":[],"unresolved":[],"colours":37,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\"\n\nimport { MoreHorizontalIcon } from \"lucide-react\"\n\nimport {\n  HaloCard,\n  HaloCardAction,\n  HaloCardButton,\n  HaloCardContent,\n  HaloCardDescription,\n  HaloCardFooter,\n  HaloCardHeader,\n  HaloCardTitle,\n} from \"./halo-card\"\n\nexport default function HaloCardDemo() {\n  return (\n    <div className=\"flex w-full items-center justify-center p-8\">\n      <HaloCard aria-label=\"Invite teammates\" className=\"w-full max-w-lg\">\n        <HaloCardHeader>\n          <HaloCardTitle>Invite your team</HaloCardTitle>\n          <HaloCardDescription>\n            Northwind Studio has 3 of 10 seats in use. Invites expire after\n            seven days.\n          </HaloCardDescription>\n          <HaloCardAction>\n            <HaloCardButton\n              aria-label=\"More options\"\n              size=\"icon\"\n              type=\"button\"\n              variant=\"secondary\"\n            >\n              <MoreHorizontalIcon aria-hidden className=\"size-4\" />\n            </HaloCardButton>\n          </HaloCardAction>\n        </HaloCardHeader>\n\n        <HaloCardContent>\n          <ul className=\"space-y-3\">\n            {[\n              { name: \"Priya Raman\", email: \"priya@northwind.studio\", img: 32, role: \"Admin\" },\n              { name: \"Marcus Webb\", email: \"marcus@northwind.studio\", img: 14, role: \"Editor\" },\n              { name: \"Lena Fischer\", email: \"lena@northwind.studio\", img: 45, role: \"Viewer\" },\n            ].map((p) => (\n              <li className=\"flex items-center gap-3\" key={p.email}>\n                <img\n                  alt=\"\"\n                  className=\"size-8 rounded-full object-cover\"\n                  src={`https://i.pravatar.cc/80?img=${p.img}`}\n                />\n                <div className=\"min-w-0 flex-1\">\n                  <p className=\"font-medium text-foreground text-sm\">{p.name}</p>\n                  <p className=\"truncate text-muted-foreground text-xs\">{p.email}</p>\n                </div>\n                <span className=\"text-muted-foreground text-xs\">{p.role}</span>\n              </li>\n            ))}\n          </ul>\n        </HaloCardContent>\n\n        <HaloCardFooter className=\"justify-between gap-3\">\n          <HaloCardButton type=\"button\" variant=\"secondary\">\n            Cancel\n          </HaloCardButton>\n          <HaloCardButton type=\"button\" variant=\"primary\">\n            Send invites\n          </HaloCardButton>\n        </HaloCardFooter>\n      </HaloCard>\n    </div>\n  )\n}","file":"components/ui/halo-card.tsx","registryItem":"https://stashui.vermarjun.xyz/r/halo-card.json","live":"https://stashui.vermarjun.xyz/c/halo-card"}