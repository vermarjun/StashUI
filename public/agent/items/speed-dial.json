{"name":"speed-dial","title":"Speed Dial","kind":"dock","origin":"Dice UI","description":"Round trigger that fans out labelled quick actions like like, copy and share.","use":"Floating action menu with a few quick actions.","avoid":"","a11y":"","exports":["SpeedDial","SpeedDialAction","SpeedDialContent","SpeedDialItem","SpeedDialLabel","SpeedDialTrigger"],"props":[],"npm":["class-variance-authority","radix-ui"],"registry":["button"],"colours":0,"sizedParent":false,"css":false,"alternatives":[],"usage":"\"use client\";\n\nimport { Copy, Heart, Plus, Share2 } from \"lucide-react\";\nimport * as React from \"react\";\n\nimport {\n  SpeedDial,\n  SpeedDialAction,\n  SpeedDialContent,\n  SpeedDialItem,\n  SpeedDialLabel,\n  SpeedDialTrigger,\n} from \"./speed-dial\";\n\nexport default function SpeedDialDemo() {\n  const [last, setLast] = React.useState<string | null>(null);\n\n  return (\n    <div className=\"flex h-[360px] w-full max-w-md flex-col items-center justify-end gap-6\">\n      <p className=\"h-5 text-sm text-muted-foreground\">\n        {last ? `${last} ✓` : \"Open the menu to see quick actions\"}\n      </p>\n      <SpeedDial>\n        <SpeedDialTrigger className=\"transition-transform duration-200 ease-out data-[state=closed]:rotate-0 data-[state=open]:rotate-135\">\n          <Plus />\n        </SpeedDialTrigger>\n        <SpeedDialContent>\n          <SpeedDialItem>\n            <SpeedDialLabel>Share</SpeedDialLabel>\n            <SpeedDialAction onSelect={() => setLast(\"Link shared\")}>\n              <Share2 />\n            </SpeedDialAction>\n          </SpeedDialItem>\n          <SpeedDialItem>\n            <SpeedDialLabel>Copy</SpeedDialLabel>\n            <SpeedDialAction onSelect={() => setLast(\"Copied to clipboard\")}>\n              <Copy />\n            </SpeedDialAction>\n          </SpeedDialItem>\n          <SpeedDialItem>\n            <SpeedDialLabel>Like</SpeedDialLabel>\n            <SpeedDialAction onSelect={() => setLast(\"Added to favourites\")}>\n              <Heart />\n            </SpeedDialAction>\n          </SpeedDialItem>\n        </SpeedDialContent>\n      </SpeedDial>\n    </div>\n  );\n}","file":"components/ui/speed-dial.tsx","registryItem":"https://stashui.vermarjun.xyz/r/speed-dial.json","live":"https://stashui.vermarjun.xyz/c/speed-dial"}