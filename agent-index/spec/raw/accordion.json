{
  "name": "accordion",
  "blurb": "Click headers to toggle content visibility with smooth animation.",
  "description": "Stack of collapsible sections with click-to-expand headers and animated content reveal. Supports single or multiple open sections via the `multiple` prop.",
  "use_when": "Organizing lengthy content into scannable categories, FAQ pages, or documentation.",
  "avoid_when": "When all content should be visible at once. Touch-heavy interfaces benefit from larger click targets.",
  "a11y": "Headers are buttons with aria-expanded. Panels have role=region and aria-labelledby. Keyboard-navigable.",
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true
    },
    {
      "name": "multiple",
      "type": "boolean",
      "default": null,
      "required": false
    },
    {
      "name": "defaultValue",
      "type": "string | string[]",
      "default": null,
      "required": false
    },
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true
    },
    {
      "name": "value",
      "type": "string",
      "default": null,
      "required": true
    },
    {
      "name": "className",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true
    },
    {
      "name": "customIcon",
      "type": "boolean",
      "default": null,
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "children",
      "type": "ReactNode",
      "default": null,
      "required": true
    },
    {
      "name": "className",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "articleClassName",
      "type": "string",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "click"
    ],
    "motion": "subtle",
    "affects": [
      "background",
      "fill",
      "layout"
    ],
    "tone": "minimal",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": [
    "faq-accordion",
    "body-text",
    "section-background"
  ]
