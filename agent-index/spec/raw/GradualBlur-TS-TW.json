{
  "name": "GradualBlur-TS-TW",
  "blurb": "Content gradually blurs and fades away at the edges, hinting there's more to scroll.",
  "description": "An overlay that applies progressive backdrop blur and masking from one or more edges (top, bottom, left, right). Uses layered div elements with increasing blur values to create a smooth fade effect. Supports responsive sizing, scroll animation, and preset configurations.",
  "use_when": "Lists or scrollable content need a visual fade-to-nothing effect that encourages scrolling and provides polish.",
  "avoid_when": "The parent container isn't positioned as relative or fixed.",
  "a11y": "Visual overlay only; doesn't affect content reachability or keyboard navigation.",
  "props": [
    {"name": "children", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "position", "type": "\"top\" | \"bottom\" | \"left\" | \"right\"", "default": "\"bottom\"", "required": false},
    {"name": "strength", "type": "number", "default": "2", "required": false},
    {"name": "height", "type": "string", "default": "\"6rem\"", "required": false},
    {"name": "width", "type": "string", "default": null, "required": false},
    {"name": "divCount", "type": "number", "default": "5", "required": false},
    {"name": "exponential", "type": "boolean", "default": "false", "required": false},
    {"name": "zIndex", "type": "number", "default": "1000", "required": false},
    {"name": "animated", "type": "boolean | \"scroll\"", "default": "false", "required": false},
    {"name": "duration", "type": "string", "default": "\"0.3s\"", "required": false},
    {"name": "easing", "type": "string", "default": "\"ease-out\"", "required": false},
    {"name": "opacity", "type": "number", "default": "1", "required": false},
    {"name": "curve", "type": "\"linear\" | \"bezier\" | \"ease-in\" | \"ease-out\" | \"ease-in-out\"", "default": "\"linear\"", "required": false},
    {"name": "responsive", "type": "boolean", "default": "false", "required": false},
    {"name": "mobileHeight", "type": "string", "default": null, "required": false},
    {"name": "tabletHeight", "type": "string", "default": null, "required": false},
    {"name": "desktopHeight", "type": "string", "default": null, "required": false},
    {"name": "mobileWidth", "type": "string", "default": null, "required": false},
    {"name": "tabletWidth", "type": "string", "default": null, "required": false},
    {"name": "desktopWidth", "type": "string", "default": null, "required": false},
    {"name": "preset", "type": "string", "default": null, "required": false},
    {"name": "gpuOptimized", "type": "boolean", "default": null, "required": false},
    {"name": "hoverIntensity", "type": "number", "default": null, "required": false},
    {"name": "target", "type": "\"parent\" | \"page\"", "default": "\"parent\"", "required": false},
    {"name": "onAnimationComplete", "type": "() => void", "default": null, "required": false},
    {"name": "className", "type": "string", "default": "\"\"", "required": false},
    {"name": "style", "type": "CSSProperties", "default": "{}", "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "subtle",
    "affects": ["opacity"],
    "tone": "minimal",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["section-background", "body-text", "sidebar"]
}
