{
  "blurb": "Radix Slider primitive with basic styling.",
  "description": "A simple, accessible slider using the Radix Slider primitive with minimal styling.",
  "use_when": "A baseline slider with full Radix accessibility.",
  "avoid_when": "When custom visual styling is required.",
  "a11y": "Full Radix Slider ARIA and keyboard support.",
  "props": [
    {
      "name": "min",
      "type": "number",
      "default": "0",
      "required": false
    },
    {
      "name": "max",
      "type": "number",
      "default": "100",
      "required": false
    },
    {
      "name": "step",
      "type": "number",
      "default": "1",
      "required": false
    },
    {
      "name": "value",
      "type": "number[]",
      "default": null,
      "required": false
    },
    {
      "name": "onValueChange",
      "type": "(v:number[])=>void",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "drag"
    ],
    "motion": "none",
    "affects": [
      "fill"
    ],
    "tone": "minimal",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": [
    "form-field"
  ]
}