{
  "name": "image-hover-accordion",
  "blurb": "Accordion items with hover image reveal.",
  "description": "Each accordion header has an associated image that appears/animates on hover before expanding.",
  "use_when": "Visual accordions with hero images per section.",
  "avoid_when": "Text-only accordions.",
  "a11y": "Images have alt text, hover is supplemented by click interaction.",
  "props": [
    {
      "name": "items",
      "type": "item[]",
      "default": null,
      "required": true
    },
    {
      "name": "setIndex",
      "type": "React.Dispatch<SetStateAction<number>>",
      "default": null,
      "required": true
    },
    {
      "name": "index",
      "type": "number | undefined",
      "default": null,
      "required": true
    }
  ],
  "traits": {
    "trigger": [
      "hover",
      "click"
    ],
    "motion": "subtle",
    "affects": [
      "background",
      "image"
    ],
    "tone": "minimal",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": [
    "feature-card",
    "hero"
  ]
}