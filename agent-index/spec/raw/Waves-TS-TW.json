{
  "name": "Waves-TS-TW",
  "blurb": "Layered waves flow and interfere naturally.",
  "description": "Multi-layered wave simulation with interference patterns and phase shifting.",
  "use_when": "Water, liquid, or ocean-themed backgrounds.",
  "avoid_when": "Low-end mobile browsers.",
  "a11y": "Decorative background. No keyboard or focus handling required.",
  "props": [
    {
      "name": "lineColor",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "waveSpeedX",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "waveSpeedY",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "waveAmpX",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "waveAmpY",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "xGap",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "yGap",
      "type": "number",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "pointer-move"
    ],
    "motion": "continuous",
    "affects": [
      "background"
    ],
    "tone": "dramatic",
    "theme": "dark",
    "needs_sized_parent": true
  },
  "slot_hints": [
    "page-background",
    "section-background"
  ]
}