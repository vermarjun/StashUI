{
  "name": "Plasma-TS-TW",
  "blurb": "Plasma waves pulse and shift with energy.",
  "description": "Procedural plasma effect with Perlin noise and time-based animation.",
  "use_when": "Energetic, sci-fi backgrounds.",
  "avoid_when": "Low-end browsers; continuous RAF rendering.",
  "a11y": "Decorative background. No keyboard or focus handling required.",
  "props": [
    {
      "name": "color",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "speed",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "direction",
      "type": "'forward' | 'reverse' | 'pingpong'",
      "default": null,
      "required": false
    },
    {
      "name": "scale",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "opacity",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "mouseInteractive",
      "type": "boolean",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "pointer-move"
    ],
    "motion": "continuous",
    "affects": [
      "background"
    ],
    "tone": "dramatic",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": [
    "page-background",
    "section-background"
  ]
}