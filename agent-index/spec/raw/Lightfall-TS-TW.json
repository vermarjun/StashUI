{
  "name": "Lightfall-TS-TW",
  "blurb": "Streaks of light fall from above with optional mouse interaction.",
  "description": "WebGL-rendered falling light streaks with configurable colors, density, and mouse influence. Supports glow, twinkle, and blend modes.",
  "use_when": "Atmospheric backgrounds with rain-like light particles.",
  "avoid_when": "Low-end devices without WebGL support; continuous rendering.",
  "a11y": "Decorative background. No keyboard or focus handling required.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "dpr",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "paused",
      "type": "boolean",
      "default": null,
      "required": false
    },
    {
      "name": "colors",
      "type": "string[]",
      "default": null,
      "required": false
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": null,
      "required": false
    },
    {
      "name": "speed",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "streakCount",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "streakWidth",
      "type": "number",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "pointer-move"
    ],
    "motion": "continuous",
    "affects": [
      "background"
    ],
    "tone": "dramatic",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": [
    "page-background",
    "section-background"
  ]
}