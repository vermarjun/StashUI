{"name":"AnimatedContent-TS-TW","blurb":"Content slides in from off-screen when scrolling it into view.","description":"Wraps children; animates slide-in on scroll with customizable distance, direction, scale, and opacity. Uses GSAP ScrollTrigger for scroll detection. Optionally disappears after a delay.","use_when":"Reveal content on scroll, add entrance animations to sections, or create depth with staggered reveals.","avoid_when":"Reduced motion preference; no prefers-reduced-motion handling. GSAP requires license considerations.","a11y":"Starts invisible; content becomes visible via animation. No aria attributes; depends on semantic structure.","props":[{"name":"children","type":"React.ReactNode","default":null,"required":true},{"name":"container","type":"Element | string | null","default":null,"required":false},{"name":"distance","type":"number","default":"100","required":false},{"name":"direction","type":"\"vertical\" | \"horizontal\"","default":"vertical","required":false},{"name":"reverse","type":"boolean","default":"false","required":false},{"name":"duration","type":"number","default":"0.8","required":false},{"name":"ease","type":"string","default":"power3.out","required":false},{"name":"initialOpacity","type":"number","default":"0","required":false},{"name":"animateOpacity","type":"boolean","default":"true","required":false},{"name":"scale","type":"number","default":"1","required":false},{"name":"threshold","type":"number","default":"0.1","required":false},{"name":"delay","type":"number","default":"0","required":false},{"name":"disappearAfter","type":"number","default":"0","required":false},{"name":"disappearDuration","type":"number","default":"0.5","required":false},{"name":"disappearEase","type":"string","default":"power3.in","required":false},{"name":"onComplete","type":"() => void","default":null,"required":false},{"name":"onDisappearanceComplete","type":"() => void","default":null,"required":false},{"name":"className","type":"string","default":"","required":false}],"traits":{"trigger":["scroll"],"motion":"pronounced","affects":["children"],"tone":"minimal","theme":"both","needs_sized_parent":false},"slot_hints":["body-text","decoration"]}
