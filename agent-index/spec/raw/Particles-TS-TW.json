{
  "name": "Particles-TS-TW",
  "blurb": "Particles float and interact across the space.",
  "description": "Particle system with physics-based movement, collision, and optional interactivity.",
  "use_when": "Interactive, dynamic backgrounds with depth.",
  "avoid_when": "Devices without efficient GPU or canvas support.",
  "a11y": "Decorative background. No keyboard or focus handling required.",
  "props": [
    {
      "name": "particleCount",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "particleSpread",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "speed",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "particleColors",
      "type": "string[]",
      "default": null,
      "required": false
    },
    {
      "name": "moveParticlesOnHover",
      "type": "boolean",
      "default": null,
      "required": false
    },
    {
      "name": "particleHoverFactor",
      "type": "number",
      "default": null,
      "required": false
    },
    {
      "name": "alphaParticles",
      "type": "boolean",
      "default": null,
      "required": false
    },
    {
      "name": "particleBaseSize",
      "type": "number",
      "default": null,
      "required": false
    }
  ],
  "traits": {
    "trigger": [
      "pointer-move"
    ],
    "motion": "continuous",
    "affects": [
      "background"
    ],
    "tone": "dramatic",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": [
    "page-background",
    "section-background"
  ]
}