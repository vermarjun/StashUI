{
  "name": "hover-video-player",
  "blurb": "Plays on hover, pauses when pointer leaves or screen scrolls out.",
  "description": "A video player that activates on hover (or touch controls on mobile), with lazy loading via intersection observer, thumbnail support, and optional picture-in-picture. Context-based state management for controls, playback, and overlay animations.",
  "use_when": "Product previews or media galleries where video should reveal on interaction without autoplay complexity.",
  "avoid_when": "When video autoplay is required, or when Vimeo SDK cannot load. Needs explicit parent sizing or aspect-ratio padding.",
  "a11y": "Play/pause, mute, and PiP buttons have aria-labels; respects prefers-reduced-motion for overlays; keyboard accessible through button controls; touch support on mobile.",
  "props": [
    {"name": "videoSrc", "type": "string", "default": null, "required": true},
    {"name": "thumbnailSrc", "type": "string | undefined", "default": null, "required": false},
    {"name": "hoverOverlay", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "pausedOverlay", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "loadingOverlay", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "playbackStartDelay", "type": "number", "default": "0", "required": false},
    {"name": "restartOnPaused", "type": "boolean", "default": "false", "required": false},
    {"name": "unloadVideoOnPaused", "type": "boolean", "default": "false", "required": false},
    {"name": "playbackRangeStart", "type": "number | undefined", "default": null, "required": false},
    {"name": "playbackRangeEnd", "type": "number | undefined", "default": null, "required": false},
    {"name": "muted", "type": "boolean", "default": "false", "required": false},
    {"name": "loop", "type": "boolean", "default": "true", "required": false},
    {"name": "preload", "type": "\"auto\" | \"metadata\" | \"none\"", "default": "\"metadata\"", "required": false},
    {"name": "className", "type": "string | undefined", "default": null, "required": false},
    {"name": "style", "type": "React.CSSProperties", "default": null, "required": false},
    {"name": "onHoverStart", "type": "() => void", "default": null, "required": false},
    {"name": "onHoverEnd", "type": "() => void", "default": null, "required": false},
    {"name": "enableControls", "type": "boolean", "default": "false", "required": false},
    {"name": "cropTop", "type": "number", "default": "0", "required": false},
    {"name": "cropBottom", "type": "number", "default": "0", "required": false},
    {"name": "isVimeo", "type": "boolean", "default": "false", "required": false}
  ],
  "traits": {
    "trigger": ["hover", "touch"],
    "motion": "subtle",
    "affects": ["background"],
    "tone": "minimal",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": ["media"]
}
