{
  "name": "inspira-dither-shader",
  "blurb": "Canvas-rendered images with dithering patterns and color quantization.",
  "description": "Canvas component applying ordered dithering (bayer, halftone, noise, crosshatch) and color reduction to images. Supports brightness, contrast, palette modes, and frame animation.",
  "use_when": "Artistic image effects for galleries, retro aesthetics, or stylized presentations.",
  "avoid_when": "Real-time video or high-volume galleries — canvas processing has per-frame CPU cost.",
  "a11y": "Canvas-rendered with aria-label and role=img. Image source is loaded but not directly exposed to screen readers.",
  "props": [
    {"name": "src", "type": "string", "default": null, "required": true},
    {"name": "gridSize", "type": "number", "default": "4", "required": false},
    {"name": "ditherMode", "type": "\"bayer\" | \"halftone\" | \"noise\" | \"crosshatch\"", "default": "\"bayer\"", "required": false},
    {"name": "colorMode", "type": "\"original\" | \"grayscale\" | \"duotone\" | \"custom\"", "default": "\"original\"", "required": false},
    {"name": "invert", "type": "boolean", "default": "false", "required": false},
    {"name": "pixelRatio", "type": "number", "default": "1", "required": false},
    {"name": "primaryColor", "type": "string", "default": "\"#000000\"", "required": false},
    {"name": "secondaryColor", "type": "string", "default": "\"#ffffff\"", "required": false},
    {"name": "customPalette", "type": "string[]", "default": "[\"#000000\", \"#ffffff\"]", "required": false},
    {"name": "brightness", "type": "number", "default": "0", "required": false},
    {"name": "contrast", "type": "number", "default": "1", "required": false},
    {"name": "backgroundColor", "type": "string", "default": "\"transparent\"", "required": false},
    {"name": "objectFit", "type": "\"cover\" | \"contain\" | \"fill\" | \"none\"", "default": "\"cover\"", "required": false},
    {"name": "threshold", "type": "number", "default": "0.5", "required": false},
    {"name": "animated", "type": "boolean", "default": "false", "required": false},
    {"name": "animationSpeed", "type": "number", "default": "0.02", "required": false},
    {"name": "className", "type": "string", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "none",
    "affects": ["image"],
    "tone": "technical",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": ["media", "feature-card"]
}
