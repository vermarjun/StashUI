{
  "name": "OrbitImages-TS-TW",
  "blurb": "Images or elements orbit around a customizable path (circle, ellipse, star, heart, infinity, or custom).",
  "description": "Framer Motion-powered orbit using CSS offsetPath to move child elements or images around any SVG path. Supports multiple preset shapes and custom SVG paths.",
  "use_when": "Gallery layouts, testimonial carousels, or logo walls where a circular/orbital motion reinforces a cohesive visual theme.",
  "avoid_when": "High-performance contexts on low-end devices — continuous RAF-driven transforms can be costly; or when elements must support direct interaction.",
  "a11y": "Passive decorative layout tool; children retain their semantics. Marked aria-hidden. No keyboard interaction or focus states. Does not respect prefers-reduced-motion.",
  "props": [
    {"name": "images", "type": "string[]", "default": "[]", "required": false},
    {"name": "altPrefix", "type": "string", "default": "Orbiting image", "required": false},
    {"name": "shape", "type": "'ellipse' | 'circle' | 'square' | 'rectangle' | 'triangle' | 'star' | 'heart' | 'infinity' | 'wave' | 'custom'", "default": "ellipse", "required": false},
    {"name": "customPath", "type": "string", "default": null, "required": false},
    {"name": "baseWidth", "type": "number", "default": "1400", "required": false},
    {"name": "radiusX", "type": "number", "default": "700", "required": false},
    {"name": "radiusY", "type": "number", "default": "170", "required": false},
    {"name": "radius", "type": "number", "default": "300", "required": false},
    {"name": "starPoints", "type": "number", "default": "5", "required": false},
    {"name": "starInnerRatio", "type": "number", "default": "0.5", "required": false},
    {"name": "rotation", "type": "number", "default": "-8", "required": false},
    {"name": "duration", "type": "number", "default": "40", "required": false},
    {"name": "itemSize", "type": "number", "default": "64", "required": false},
    {"name": "direction", "type": "'normal' | 'reverse'", "default": "normal", "required": false},
    {"name": "fill", "type": "boolean", "default": "true", "required": false},
    {"name": "width", "type": "number | '100%'", "default": "100", "required": false},
    {"name": "height", "type": "number | 'auto'", "default": "100", "required": false},
    {"name": "className", "type": "string", "default": "", "required": false},
    {"name": "showPath", "type": "boolean", "default": "false", "required": false},
    {"name": "pathColor", "type": "string", "default": "rgba(0,0,0,0.1)", "required": false},
    {"name": "pathWidth", "type": "number", "default": "2", "required": false},
    {"name": "easing", "type": "'linear' | 'easeIn' | 'easeOut' | 'easeInOut'", "default": "linear", "required": false},
    {"name": "paused", "type": "boolean", "default": "false", "required": false},
    {"name": "centerContent", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "responsive", "type": "boolean", "default": "false", "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "continuous",
    "affects": ["children"],
    "tone": "decorative",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["logo-wall", "testimonial", "feature-card"]
}
