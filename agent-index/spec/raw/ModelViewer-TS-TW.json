{
  "name": "ModelViewer-TS-TW",
  "blurb": "3D model viewer with drag rotation, parallax, and configurable lighting using Three.js.",
  "description": "Renders GLB, GLTF, FBX, or OBJ models in an interactive 3D canvas. Supports drag-to-rotate, mouse parallax, auto-rotation, and pinch-zoom on touch. Includes environment presets and shadow support.",
  "use_when": "Showcasing 3D assets, product models, or interactive visualizations that benefit from real-time rotation and lighting control.",
  "avoid_when": "Touch-only devices without proper gesture support, or when model formats like GLTF need complex post-processing beyond basic lighting.",
  "a11y": "Primarily visual. Screenshot button is keyboard-accessible. No focus indicators on the model itself. Parallax motion cannot be disabled.",
  "props": [
    {"name": "url", "type": "string", "default": null, "required": true},
    {"name": "width", "type": "number | string", "default": "400", "required": false},
    {"name": "height", "type": "number | string", "default": "400", "required": false},
    {"name": "modelXOffset", "type": "number", "default": "0", "required": false},
    {"name": "modelYOffset", "type": "number", "default": "0", "required": false},
    {"name": "defaultRotationX", "type": "number", "default": "-50", "required": false},
    {"name": "defaultRotationY", "type": "number", "default": "20", "required": false},
    {"name": "defaultZoom", "type": "number", "default": "0.5", "required": false},
    {"name": "minZoomDistance", "type": "number", "default": "0.5", "required": false},
    {"name": "maxZoomDistance", "type": "number", "default": "10", "required": false},
    {"name": "enableMouseParallax", "type": "boolean", "default": "true", "required": false},
    {"name": "enableManualRotation", "type": "boolean", "default": "true", "required": false},
    {"name": "enableHoverRotation", "type": "boolean", "default": "true", "required": false},
    {"name": "enableManualZoom", "type": "boolean", "default": "true", "required": false},
    {"name": "ambientIntensity", "type": "number", "default": "0.3", "required": false},
    {"name": "keyLightIntensity", "type": "number", "default": "1", "required": false},
    {"name": "fillLightIntensity", "type": "number", "default": "0.5", "required": false},
    {"name": "rimLightIntensity", "type": "number", "default": "0.8", "required": false},
    {"name": "environmentPreset", "type": "'city' | 'sunset' | 'night' | 'dawn' | 'studio' | 'apartment' | 'forest' | 'park' | 'none'", "default": "'forest'", "required": false},
    {"name": "autoFrame", "type": "boolean", "default": "false", "required": false},
    {"name": "placeholderSrc", "type": "string", "default": null, "required": false},
    {"name": "showScreenshotButton", "type": "boolean", "default": "true", "required": false},
    {"name": "fadeIn", "type": "boolean", "default": "false", "required": false},
    {"name": "autoRotate", "type": "boolean", "default": "false", "required": false},
    {"name": "autoRotateSpeed", "type": "number", "default": "0.35", "required": false},
    {"name": "onModelLoaded", "type": "() => void", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["drag", "pointer-move", "hover", "click"],
    "motion": "pronounced",
    "affects": ["image"],
    "tone": "technical",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": ["media", "feature-card"]
}
