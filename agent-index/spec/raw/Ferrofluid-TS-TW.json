{
  "name": "Ferrofluid-TS-TW",
  "blurb": "Flowing liquid effect with directional turbulence and shimmer.",
  "description": "WebGL shader using value noise and distortion to simulate ferrofluids flowing in a specified direction. Supports customizable colors, turbulence, fluidity, shimmer, and optional mouse interaction for glow effects.",
  "use_when": "Liquid, organic backgrounds where flowing motion creates a sense of dynamism and fluidity.",
  "avoid_when": "Static backgrounds or light themes; this effect is designed for dark, immersive experiences.",
  "a11y": "WebGL canvas with optional mouse interaction. No semantic content or keyboard navigation. No prefers-reduced-motion guard.",
  "props": [
    {"name": "className", "type": "string", "default": null, "required": false},
    {"name": "dpr", "type": "number", "default": null, "required": false},
    {"name": "paused", "type": "boolean", "default": "false", "required": false},
    {"name": "colors", "type": "string[]", "default": "[\"#ffffff\", \"#ffffff\", \"#ffffff\"]", "required": false},
    {"name": "speed", "type": "number", "default": "0.5", "required": false},
    {"name": "scale", "type": "number", "default": "1.6", "required": false},
    {"name": "turbulence", "type": "number", "default": "1", "required": false},
    {"name": "fluidity", "type": "number", "default": "0.1", "required": false},
    {"name": "rimWidth", "type": "number", "default": "0.2", "required": false},
    {"name": "sharpness", "type": "number", "default": "2.5", "required": false},
    {"name": "shimmer", "type": "number", "default": "1.5", "required": false},
    {"name": "glow", "type": "number", "default": "2", "required": false},
    {"name": "flowDirection", "type": "\"up\" | \"down\" | \"left\" | \"right\"", "default": "\"down\"", "required": false},
    {"name": "opacity", "type": "number", "default": "1", "required": false},
    {"name": "mouseInteraction", "type": "boolean", "default": "true", "required": false},
    {"name": "mouseStrength", "type": "number", "default": "1", "required": false},
    {"name": "mouseRadius", "type": "number", "default": "0.35", "required": false},
    {"name": "mouseDampening", "type": "number", "default": "0.15", "required": false},
    {"name": "mixBlendMode", "type": "string", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["always", "pointer-move"],
    "motion": "continuous",
    "affects": ["background"],
    "tone": "dramatic",
    "theme": "dark",
    "needs_sized_parent": true
  },
  "slot_hints": ["page-background", "section-background", "hero"]
}
