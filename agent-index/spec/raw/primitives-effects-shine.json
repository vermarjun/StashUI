{
  "name": "primitives-effects-shine",
  "blurb": "Animated shine effect sweeps across content, continuously or on hover/click.",
  "description": "Renders an animated shine/gloss effect that sweeps across child content. Runs continuously, on hover, or on click with customizable color, opacity, and direction.",
  "use_when": "Buttons, cards, or premium UI elements where a shine effect adds perceived polish and draws visual attention.",
  "avoid_when": "Content already using shine effects where layering might create visual noise.",
  "a11y": "Shine effect is purely visual; no impact on semantic content or keyboard interaction.",
  "props": [
    {"name": "children", "type": "React.ReactNode", "default": null, "required": false},
    {"name": "color", "type": "string", "default": "\"currentColor\"", "required": false},
    {"name": "opacity", "type": "number", "default": "0.3", "required": false},
    {"name": "delay", "type": "number", "default": "0", "required": false},
    {"name": "duration", "type": "number", "default": "1200", "required": false},
    {"name": "loop", "type": "boolean", "default": "false", "required": false},
    {"name": "loopDelay", "type": "number", "default": "0", "required": false},
    {"name": "deg", "type": "number", "default": "-15", "required": false},
    {"name": "enable", "type": "boolean", "default": "true", "required": false},
    {"name": "enableOnHover", "type": "boolean", "default": "false", "required": false},
    {"name": "enableOnTap", "type": "boolean", "default": "false", "required": false},
    {"name": "asChild", "type": "boolean", "default": "false", "required": false},
    {"name": "style", "type": "React.CSSProperties", "default": null, "required": false},
    {"name": "className", "type": "string", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "subtle",
    "affects": ["fill"],
    "tone": "decorative",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["primary-cta", "feature-card", "decoration"]
}
