{
  "name": "Ribbons-TS-TW",
  "blurb": "Colored ribbons trail the cursor with spring physics.",
  "description": "Renders WebGL ribbons following pointer position using spring physics. Each ribbon has independent physics parameters and optional shader wave effects or fade.",
  "use_when": "Full-screen hero backgrounds or interactive effects on dark surfaces.",
  "avoid_when": "Touch-only devices (tracks pointer only); requires a sized parent container.",
  "a11y": "Canvas wrapper only; no keyboard interaction or prefers-reduced-motion support.",
  "props": [
    {"name": "colors", "type": "string[]", "default": "[\"#ff9346\", \"#7cff67\", \"#ffee51\", \"#5227FF\"]", "required": false},
    {"name": "baseSpring", "type": "number", "default": "0.03", "required": false},
    {"name": "baseFriction", "type": "number", "default": "0.9", "required": false},
    {"name": "baseThickness", "type": "number", "default": "30", "required": false},
    {"name": "offsetFactor", "type": "number", "default": "0.05", "required": false},
    {"name": "maxAge", "type": "number", "default": "500", "required": false},
    {"name": "pointCount", "type": "number", "default": "50", "required": false},
    {"name": "speedMultiplier", "type": "number", "default": "0.6", "required": false},
    {"name": "enableFade", "type": "boolean", "default": "false", "required": false},
    {"name": "enableShaderEffect", "type": "boolean", "default": "false", "required": false},
    {"name": "effectAmplitude", "type": "number", "default": "2", "required": false},
    {"name": "backgroundColor", "type": "number[]", "default": "[0, 0, 0, 0]", "required": false}
  ],
  "traits": {
    "trigger": ["pointer-move"],
    "motion": "continuous",
    "affects": ["background"],
    "tone": "decorative",
    "theme": "both",
    "needs_sized_parent": true
  },
  "slot_hints": ["page-background", "hero", "section-background"]
}
