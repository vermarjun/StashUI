{"name":"Antigravity-TS-TW","blurb":"Particles swarm and orbit around the cursor in 3D space.","description":"Renders hundreds of particles in WebGL using Three.js and react-three-fiber. Particles orbit in waves and react to cursor position. Supports various shapes and customizable physics.","use_when":"Hero sections with eye-catching motion, interactive backgrounds for tech products.","avoid_when":"Mobile devices; WebGL performance varies. Old browsers without WebGL support.","a11y":"Purely decorative particle animation. No aria labels or keyboard interaction.","props":[{"name":"count","type":"number","default":"300","required":false},{"name":"magnetRadius","type":"number","default":"10","required":false},{"name":"ringRadius","type":"number","default":"10","required":false},{"name":"waveSpeed","type":"number","default":"0.4","required":false},{"name":"waveAmplitude","type":"number","default":"1","required":false},{"name":"particleSize","type":"number","default":"2","required":false},{"name":"lerpSpeed","type":"number","default":"0.1","required":false},{"name":"color","type":"string","default":"#FF9FFC","required":false},{"name":"autoAnimate","type":"boolean","default":"false","required":false},{"name":"particleVariance","type":"number","default":"1","required":false},{"name":"rotationSpeed","type":"number","default":"0","required":false},{"name":"depthFactor","type":"number","default":"1","required":false},{"name":"pulseSpeed","type":"number","default":"3","required":false},{"name":"particleShape","type":"\"capsule\" | \"sphere\" | \"box\" | \"tetrahedron\"","default":"capsule","required":false},{"name":"fieldStrength","type":"number","default":"10","required":false}],"traits":{"trigger":["pointer-move"],"motion":"continuous","affects":["background"],"tone":"decorative","theme":"both","needs_sized_parent":true},"slot_hints":["page-background"]}
