{
  "name": "animated-beam",
  "blurb": "Animated gradient line flowing between two elements.",
  "description": "Renders an SVG path that animates a gradient beam flowing from one DOM element to another. Supports customizable curve, direction, speed, and repeat.",
  "use_when": "System diagrams, data flow visualizations, or connection indicators between UI elements.",
  "avoid_when": "Motion-sensitive users (no prefers-reduced-motion); complex layouts (ref tracking overhead).",
  "a11y": "SVG overlay; no interactive elements. Motion-based only, no semantic content.",
  "props": [
    {"name": "className", "type": "string", "default": null, "required": false},
    {"name": "containerRef", "type": "RefObject<HTMLElement>", "default": null, "required": true},
    {"name": "fromRef", "type": "RefObject<HTMLElement>", "default": null, "required": true},
    {"name": "toRef", "type": "RefObject<HTMLElement>", "default": null, "required": true},
    {"name": "curvature", "type": "number", "default": "0", "required": false},
    {"name": "reverse", "type": "boolean", "default": "false", "required": false},
    {"name": "pathColor", "type": "string", "default": "\"gray\"", "required": false},
    {"name": "pathWidth", "type": "number", "default": "2", "required": false},
    {"name": "pathOpacity", "type": "number", "default": "0.2", "required": false},
    {"name": "gradientStartColor", "type": "string", "default": "\"#ffaa40\"", "required": false},
    {"name": "gradientStopColor", "type": "string", "default": "\"#9c40ff\"", "required": false},
    {"name": "delay", "type": "number", "default": "0", "required": false},
    {"name": "duration", "type": "number", "default": "5", "required": false},
    {"name": "repeat", "type": "number", "default": "Infinity", "required": false},
    {"name": "repeatDelay", "type": "number", "default": "0", "required": false},
    {"name": "startXOffset", "type": "number", "default": "0", "required": false},
    {"name": "startYOffset", "type": "number", "default": "0", "required": false},
    {"name": "endXOffset", "type": "number", "default": "0", "required": false},
    {"name": "endYOffset", "type": "number", "default": "0", "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "continuous",
    "affects": ["border"],
    "tone": "technical",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["decoration", "data-table"]
}
