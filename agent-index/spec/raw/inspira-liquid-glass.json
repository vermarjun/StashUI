{
  "name": "inspira-liquid-glass",
  "blurb": "Liquid glass morphism effect with SVG displacement mapping.",
  "description": "Container creating frosted glass effect with SVG-based displacement distortion. Highly configurable blend modes, channels, and visual parameters.",
  "use_when": "Premium UI elements, overlays, or cards with glass morphism aesthetics.",
  "avoid_when": "Older browsers or when SVG displacement maps aren't supported.",
  "a11y": "Glass effect is purely visual; semantic content provided via children.",
  "props": [
    {"name": "radius", "type": "number", "default": "16", "required": false},
    {"name": "border", "type": "number", "default": "0.07", "required": false},
    {"name": "lightness", "type": "number", "default": "50", "required": false},
    {"name": "displace", "type": "number", "default": null, "required": false},
    {"name": "blend", "type": "string", "default": "\"difference\"", "required": false},
    {"name": "xChannel", "type": "\"R\" | \"G\" | \"B\"", "default": "\"R\"", "required": false},
    {"name": "yChannel", "type": "\"R\" | \"G\" | \"B\"", "default": "\"B\"", "required": false},
    {"name": "alpha", "type": "number", "default": "0.93", "required": false},
    {"name": "blur", "type": "number", "default": "11", "required": false},
    {"name": "rOffset", "type": "number", "default": "0", "required": false},
    {"name": "gOffset", "type": "number", "default": "10", "required": false},
    {"name": "bOffset", "type": "number", "default": "20", "required": false},
    {"name": "scale", "type": "number", "default": "-180", "required": false},
    {"name": "frost", "type": "number", "default": "0.05", "required": false},
    {"name": "className", "type": "string", "default": null, "required": false},
    {"name": "containerClass", "type": "string", "default": null, "required": false},
    {"name": "children", "type": "React.ReactNode", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["always"],
    "motion": "none",
    "affects": ["background"],
    "tone": "decorative",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["feature-card", "modal"]
}
