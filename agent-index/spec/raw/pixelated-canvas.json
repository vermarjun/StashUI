{
  "name": "pixelated-canvas",
  "blurb": "Image rendered as pixelated dots that distort and swirl around cursor movement.",
  "description": "Renders an image as a canvas of dots/pixels with real-time distortion based on cursor position. Supports multiple distortion modes (repel, attract, swirl) and visual effects.",
  "use_when": "Interactive galleries or premium displays where pixel art aesthetic combined with cursor interaction creates engagement.",
  "avoid_when": "Performance-sensitive devices — real-time canvas rendering with distortion is computationally demanding.",
  "a11y": "Canvas-based visual effect with no semantic content. Interactive distortion is purely visual.",
  "props": [
    {"name": "src", "type": "string", "default": null, "required": true},
    {"name": "width", "type": "number", "default": null, "required": false},
    {"name": "height", "type": "number", "default": null, "required": false},
    {"name": "cellSize", "type": "number", "default": null, "required": false},
    {"name": "dotScale", "type": "number", "default": null, "required": false},
    {"name": "shape", "type": "\"circle\" | \"square\"", "default": null, "required": false},
    {"name": "backgroundColor", "type": "string", "default": null, "required": false},
    {"name": "grayscale", "type": "boolean", "default": null, "required": false},
    {"name": "className", "type": "string", "default": null, "required": false},
    {"name": "responsive", "type": "boolean", "default": null, "required": false},
    {"name": "dropoutStrength", "type": "number", "default": null, "required": false},
    {"name": "interactive", "type": "boolean", "default": null, "required": false},
    {"name": "distortionStrength", "type": "number", "default": null, "required": false},
    {"name": "distortionRadius", "type": "number", "default": null, "required": false},
    {"name": "distortionMode", "type": "\"repel\" | \"attract\" | \"swirl\"", "default": null, "required": false},
    {"name": "followSpeed", "type": "number", "default": null, "required": false},
    {"name": "sampleAverage", "type": "boolean", "default": null, "required": false},
    {"name": "tintColor", "type": "string", "default": null, "required": false},
    {"name": "tintStrength", "type": "number", "default": null, "required": false},
    {"name": "maxFps", "type": "number", "default": null, "required": false},
    {"name": "objectFit", "type": "\"cover\" | \"contain\" | \"fill\" | \"none\"", "default": null, "required": false},
    {"name": "jitterStrength", "type": "number", "default": null, "required": false},
    {"name": "jitterSpeed", "type": "number", "default": null, "required": false},
    {"name": "fadeOnLeave", "type": "boolean", "default": null, "required": false},
    {"name": "fadeSpeed", "type": "number", "default": null, "required": false}
  ],
  "traits": {
    "trigger": ["pointer-move"],
    "motion": "subtle",
    "affects": ["fill"],
    "tone": "technical",
    "theme": "both",
    "needs_sized_parent": false
  },
  "slot_hints": ["media", "hero"]
}
