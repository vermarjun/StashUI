{
 "name": "origin-ui-slider",
 "title": "Slider",
 "category": "sliders",
 "origin": "Origin UI",
 "origin_short": "ori",
 "exports": [
  "Slider"
 ],
 "npm_deps": [
  "radix-ui"
 ],
 "registry_deps": [
  "tooltip"
 ],
 "css": false,
 "hardcoded_colors": 0,
 "flags": [],
 "usage": "import { Slider } from \"@/components/ui/slider\";\n\nexport default function Demo() {\n  return <Slider />;\n}",
 "usage_source": "demo",
 "file": "registry/origin-ui/slider.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/origin-ui-slider.json",
 "preview": "https://stashui.vercel.app/c/origin-ui-slider",
 "dupe_group": null,
 "alternatives": [],
 "blurb": "Radix Slider primitive with basic styling.",
 "description": "A simple, accessible slider using the Radix Slider primitive with minimal styling.",
 "use_when": "A baseline slider with full Radix accessibility.",
 "avoid_when": "When custom visual styling is required.",
 "a11y": "Full Radix Slider ARIA and keyboard support.",
 "props": [
  {
   "name": "min",
   "type": "number",
   "default": "0",
   "required": false
  },
  {
   "name": "max",
   "type": "number",
   "default": "100",
   "required": false
  },
  {
   "name": "value",
   "type": "number[]",
   "default": "{value}",
   "required": false
  },
  {
   "name": "onValueChange",
   "type": "(v:number[])=>void",
   "default": "{handleValueChange}",
   "required": false
  }
 ],
 "traits": {
  "trigger": [
   "drag"
  ],
  "motion": "none",
  "affects": [
   "fill"
  ],
  "tone": "minimal",
  "theme": "both",
  "needs_sized_parent": false
 },
 "slot_hints": [
  "form-field"
 ]
}