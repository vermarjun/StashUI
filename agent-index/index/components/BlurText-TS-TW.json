 "usage": "\"use client\"\n\nimport { useState } from \"react\"\nimport { RotateCcw } from \"lucide-react\"\nimport BlurText from \"@/components/ui/BlurText\"\n\nexport default function Demo() {\n  const [run, setRun] = useState(0)\n\n  return (\n    <div className=\"relative flex min-h-[380px] w-full flex-col items-center justify-center gap-6 p-12\">\n      <div key={run} className=\"flex flex-col items-center gap-6\">\n        <BlurText\n          text=\"Design systems built to last\"\n          animateBy=\"words\"\n          direction=\"top\"\n          delay={150}\n          className=\"justify-center text-5xl font-bold tracking-tight text-foreground\"\n        />\n        <BlurText\n          text=\"Composable. Accessible. Beautiful.\"\n          animateBy=\"words\"\n          direction=\"bottom\"\n          delay={120}\n          stepDuration={0.4}\n          className=\"justify-center text-2xl font-medium text-muted-foreground\"\n        />\n      </div>\n      <button\n        type=\"button\"\n        onClick={() => setRun((n) => n + 1)}\n        className=\"absolute right-4 bottom-4 inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground transition-colors hover:text-foreground\"\n      >\n        <RotateCcw className=\"size-3.5\" />\n        Replay\n      </button>\n    </div>\n  )\n}",
 "usage_source": "demo",
 "file": "registry/react-bits/BlurText.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/BlurText-TS-TW.json",
 "preview": "https://stashui.vercel.app/c/BlurText-TS-TW",
 "dupe_group": null,
 "alternatives": [],
 "blurb": "Text animates in with blur and opacity transition when scrolled into view.",
 "description": "Wraps text and staggered-animates each word (or letter) to fade in and blur-out with configurable easing. Triggered by scroll visibility via IntersectionObserver.",
 "use_when": "Body copy or headings need a polished reveal entrance as the page scrolls.",
 "avoid_when": "When prefers-reduced-motion is set — the animation continues regardless.",
 "a11y": "Text content is fully readable; uses motion/react for animation. No motion guard; runs for all users.",
