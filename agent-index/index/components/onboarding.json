{
 "name": "onboarding",
 "title": "Onboarding",
 "category": "navigation",
 "origin": "Cult UI",
 "origin_short": "cult",
 "exports": [
  "StepIndicator",
  "ChoiceGroup",
  "FeatureCarousel",
  "TipsList",
  "Onboarding"
 ],
 "npm_deps": [
  "@radix-ui/react-use-controllable-state",
  "class-variance-authority"
 ],
 "registry_deps": [
  "button"
 ],
 "css": false,
 "hardcoded_colors": 0,
 "flags": [],
 "usage": "\"use client\"\n\nimport { Onboarding } from \"@/components/ui/onboarding\"\n\nexport default function Demo() {\n  return (\n    <div className=\"flex items-center justify-center w-full min-h-[420px] p-6 bg-background\">\n      <Onboarding.Root totalSteps={3} defaultValue={1} className=\"w-full max-w-sm\">\n        <Onboarding.StepIndicator className=\"mb-6 justify-center\" />\n\n        <Onboarding.Step step={1}>\n          <Onboarding.Header\n            title=\"Welcome to myui\"\n            description=\"A personal component library built for speed and aesthetics.\"\n          />\n          <div className=\"mt-4 rounded-lg border border-border bg-muted/40 p-4 text-sm text-muted-foreground\">\n            Browse, preview, and install polished components directly into your\n            project with a single CLI command.\n          </div>\n        </Onboarding.Step>\n\n        <Onboarding.Step step={2}>\n          <Onboarding.Header\n            title=\"Pick your style\"\n            description=\"Components are minimal and monochrome by default — ready for your theme.\"\n          />\n          <div className=\"mt-4 flex flex-col gap-2\">\n            {[\"Minimal\", \"Vibrant\", \"System default\"].map((option) => (\n              <div\n                key={option}\n                className=\"flex items-center gap-3 rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground cursor-pointer hover:bg-muted/50\"\n              >\n                <span className=\"size-3 rounded-full border border-muted-foreground/50\" />\n                {option}\n              </div>\n            ))}\n          </div>\n        </Onboarding.Step>\n\n        <Onboarding.Step step={3}>\n          <Onboarding.Header\n            title=\"You're all set\"\n            description=\"Start exploring components or install your first one now.\"\n          />\n          <div className=\"mt-4 rounded-lg border border-border bg-muted/40 p-4 text-sm text-muted-foreground\">\n            Run{\" \"}\n            <code className=\"font-mono text-foreground\">npx shadcn add &lt;component&gt;</code>{\" \"}\n            to install any component from this library.\n          </div>\n        </Onboarding.Step>\n\n        <Onboarding.Navigation className=\"mt-6\" />\n      </Onboarding.Root>\n    </div>\n  )\n}",
 "usage_source": "demo",
 "file": "registry/cult-ui/onboarding.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/onboarding.json",
 "preview": "https://stashui.vercel.app/c/onboarding",
 "dupe_group": null,
 "alternatives": [],
 "blurb": "Multi-step onboarding flow with progress indicator, choice groups, and carousel.",
 "description": "Composable onboarding system with StepIndicator, ChoiceGroup, FeatureCarousel, TipsList, and Onboarding context. Supports both dots and pills progress variants, controlled and uncontrolled modes, and state callbacks for step navigation.",
 "use_when": "Building product walkthroughs, setup wizards, or feature tours that guide new users through sequential steps with…",
 "avoid_when": "Simple single-screen flows. Not ideal when steps can be skipped or accessed non-sequentially.",
 "a11y": "Keyboard navigation for step transitions. Proper ARIA attributes on progress indicator. Role and live region support via composition.",
 "props": [
  {
   "name": "currentStep",
   "type": "number",
   "default": "{currentStep}",
   "required": true
  },
  {
   "name": "totalSteps",
   "type": "number",
   "default": "{totalSteps}",
   "required": true
  },
  {
   "name": "variant",
   "type": "'dots' | 'pills'",
   "default": "\"dots\"",
   "required": false
  }
 ],
 "traits": {
  "trigger": [
   "click"
  ],
  "motion": "subtle",
  "affects": [
   "layout",
   "children"
  ],
  "tone": "minimal",
  "theme": "both",
  "needs_sized_parent": false
 },
 "slot_hints": [
  "nav",
  "hero",
  "modal"
 ]
}