 "usage": "\"use client\";\nimport RotatingText from \"@/components/ui/RotatingText\";\n\nexport default function Demo() {\n  return (\n    <div className=\"flex items-center justify-center w-full min-h-32 gap-2 text-3xl font-bold\">\n      <span>We build</span>\n      <RotatingText\n        texts={[\"beautiful\", \"fast\", \"accessible\", \"modern\"]}\n        mainClassName=\"text-blue-500\"\n        rotationInterval={2000}\n      />\n      <span>apps.</span>\n    </div>\n  );\n}",
 "usage_source": "demo",
 "file": "registry/react-bits/RotatingText.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/RotatingText-TS-TW.json",
