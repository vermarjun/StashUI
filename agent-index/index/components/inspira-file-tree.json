{
 "name": "inspira-file-tree",
 "title": "File Tree",
 "category": "data-display",
 "origin": "Inspira UI",
 "origin_short": "insp",
 "exports": [
  "File",
  "Folder",
  "Tree"
 ],
 "npm_deps": [],
