   "default": null,
   "required": false
  },
  {
   "name": "initialExpandedItems",
   "type": "string[]",
   "default": "[]",
   "required": false
  },
  {
   "name": "direction",
   "type": "rtl | ltr",
   "default": "\"ltr\"",
   "required": false
  },
  {
   "name": "children",
   "type": "ReactNode",
   "default": null,
   "required": false
  }
 ],
