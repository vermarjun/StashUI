 "usage": "\"use client\";\n\nimport { CalendarIcon } from \"lucide-react\";\n\nimport {\n  HoverCard,\n  HoverCardContent,\n  HoverCardTrigger,\n} from \"@/components/ui/hover-card\";\n\nexport default function Demo() {\n  return (\n    <div className=\"flex min-h-[420px] w-full items-center justify-center\">\n      <p className=\"text-muted-foreground text-sm\">\n        Built and maintained by{\" \"}\n        <HoverCard closeDelay={100} openDelay={0}>\n          <HoverCardTrigger asChild>\n            <a\n              className=\"font-medium text-foreground underline underline-offset-4\"\n              href=\"#\"\n            >\n              @origin_ui\n            </a>\n          </HoverCardTrigger>\n          <HoverCardContent className=\"w-80\">\n            <div className=\"flex items-start gap-3\">\n              <img\n                alt=\"Origin UI\"\n                className=\"size-10 shrink-0 rounded-full\"\n                height={40}\n                src=\"https://i.pravatar.cc/80?img=32\"\n                width={40}\n              />\n              <div className=\"space-y-1\">\n                <p className=\"font-medium text-sm\">@origin_ui</p>\n                <p className=\"text-muted-foreground text-sm\">\n                  Beautiful UI components built with Tailwind CSS and React.\n                </p>\n                <div className=\"flex items-center gap-1.5 pt-1 text-muted-foreground text-xs\">\n                  <CalendarIcon aria-hidden=\"true\" size={12} />\n                  Joined December 2023\n                </div>\n              </div>\n            </div>\n          </HoverCardContent>\n        </HoverCard>\n        .\n      </p>\n    </div>\n  );\n}",
 "usage_source": "demo",
 "file": "registry/origin-ui/hover-card.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/hover-card.json",
