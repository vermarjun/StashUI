{
 "name": "number-ticker",
 "title": "Number Ticker",
 "category": "data-display",
 "origin": "Magic UI",
 "origin_short": "mag",
 "exports": [
  "NumberTicker"
 ],
 "npm_deps": [
  "motion"
 ],
 "registry_deps": [],
 "css": false,
 "hardcoded_colors": 2,
 "flags": [
