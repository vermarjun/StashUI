 "usage": "\"use client\"\n\nimport {\n  AnimatedModal,\n  AnimatedModalBody,\n  AnimatedModalContent,\n  AnimatedModalFooter,\n  AnimatedModalTrigger,\n} from \"@/components/ui/animated-modal\"\n\nexport default function AnimatedModalDemo() {\n  return (\n    <div className=\"flex min-h-[300px] items-center justify-center p-8\">\n      <AnimatedModal>\n        <AnimatedModalTrigger className=\"rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-indigo-700\">\n          Open Modal\n        </AnimatedModalTrigger>\n\n        <AnimatedModalBody>\n          <AnimatedModalContent>\n            <h2 className=\"text-2xl font-bold text-gray-900 dark:text-white\">\n              Welcome to Animated Modal\n            </h2>\n            <p className=\"mt-4 text-gray-600 dark:text-neutral-400\">\n              This modal animates in with a spring-based 3D flip effect. It supports\n              click-outside to close, ESC key to close, and scroll locking.\n            </p>\n            <p className=\"mt-2 text-gray-600 dark:text-neutral-400\">\n              The content area is scrollable when content overflows the max height.\n            </p>\n          </AnimatedModalContent>\n\n          <AnimatedModalFooter>\n            <button\n              type=\"button\"\n              className=\"rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\"\n            >\n              Confirm\n            </button>\n          </AnimatedModalFooter>\n        </AnimatedModalBody>\n      </AnimatedModal>\n    </div>\n  )\n}",
 "usage_source": "demo",
 "file": "registry/inspira-react/animated-modal.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/inspira-animated-modal.json",
 "preview": "https://stashui.vercel.app/c/inspira-animated-modal",
