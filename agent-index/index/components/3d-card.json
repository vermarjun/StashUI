 "usage": "\"use client\";\nimport {\n  CardContainer,\n  CardBody,\n  CardItem,\n} from \"@/components/ui/3d-card\";\n\nexport default function Demo() {\n  return (\n    <CardContainer className=\"inter-var\">\n      <CardBody className=\"bg-gray-50 relative group/card dark:hover:shadow-2xl dark:hover:shadow-emerald-500/[0.1] dark:bg-black dark:border-white/[0.2] border-black/[0.1] w-auto sm:w-[30rem] h-auto rounded-xl p-6 border\">\n        <CardItem\n          translateZ=\"50\"\n          className=\"text-xl font-bold text-neutral-600 dark:text-white\"\n        >\n          Make things float in air\n        </CardItem>\n        <CardItem\n          as=\"p\"\n          translateZ=\"60\"\n          className=\"text-neutral-500 text-sm max-w-sm mt-2 dark:text-neutral-300\"\n        >\n          Hover over this card to unleash the power of CSS perspective\n        </CardItem>\n        <CardItem translateZ=\"100\" className=\"w-full mt-4\">\n          <img\n            src=\"https://images.unsplash.com/photo-1441974231531-c6227db76b6e?q=80&w=2560&auto=format&fit=crop\"\n            height=\"1000\"\n            width=\"1000\"\n            className=\"h-60 w-full object-cover rounded-xl group-hover/card:shadow-xl\"\n            alt=\"forest thumbnail\"\n          />\n        </CardItem>\n        <div className=\"flex justify-between items-center mt-20\">\n          <CardItem\n            translateZ={20}\n            as=\"a\"\n            href=\"#\"\n            className=\"px-4 py-2 rounded-xl text-xs font-normal dark:text-white\"\n          >\n            Try now →\n          </CardItem>\n          <CardItem\n            translateZ={20}\n            as=\"button\"\n            className=\"px-4 py-2 rounded-xl bg-black dark:bg-white dark:text-black text-white text-xs font-bold\"\n          >\n            Sign up\n          </CardItem>\n        </div>\n      </CardBody>\n    </CardContainer>\n  );\n}",
 "usage_source": "demo",
 "file": "registry/aceternity-ui/3d-card.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/3d-card.json",
 "preview": "https://stashui.vercel.app/c/3d-card",
 "dupe_group": null,
 "alternatives": [],
 "blurb": "Card elements rotate and tilt in 3D space following cursor movement.",
 "description": "Composite 3D card system: CardContainer tracks mouse position and applies rotateY/X transforms; CardBody is the card wrapper; CardItem elements translate and rotate in 3D on hover. Uses CSS perspective and preserve-3d.",
 "use_when": "Hero cards, feature showcases, or product demonstrations where visual depth and interactivity impress.",
 "avoid_when": "Mobile-only or accessibility-focused sites — 3D transforms don't work well on touch, and motion may disorient.",
 "a11y": "No keyboard navigation for the 3D effect. Content inside is accessible, but visual depth is mouse-only.",
