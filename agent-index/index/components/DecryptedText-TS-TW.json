 "usage": "\"use client\"\n\nimport DecryptedText from \"@/components/ui/DecryptedText\"\n\nexport default function Demo() {\n  return (\n    <div className=\"flex flex-col items-center justify-center gap-8 p-12 min-h-[200px]\">\n      <DecryptedText\n        text=\"Hover over me to decrypt!\"\n        animateOn=\"hover\"\n        speed={50}\n        maxIterations={10}\n        sequential\n        className=\"text-2xl font-bold text-green-500\"\n        encryptedClassName=\"text-2xl font-bold text-gray-400\"\n      />\n      <DecryptedText\n        text=\"Decrypted on view trigger\"\n        animateOn=\"view\"\n        speed={40}\n        maxIterations={12}\n        sequential\n        revealDirection=\"center\"\n        className=\"text-xl font-mono text-blue-500\"\n        encryptedClassName=\"text-xl font-mono text-gray-300\"\n      />\n      <DecryptedText\n        text=\"Click me to reveal the message\"\n        animateOn=\"click\"\n        clickMode=\"toggle\"\n        speed={60}\n        maxIterations={8}\n        className=\"text-lg font-semibold text-purple-500 cursor-pointer\"\n        encryptedClassName=\"text-lg font-semibold text-gray-400 cursor-pointer\"\n      />\n    </div>\n  )\n}",
 "usage_source": "demo",
 "file": "registry/react-bits/DecryptedText.tsx",
 "install": "npx shadcn@latest add https://stashui.vercel.app/r/DecryptedText-TS-TW.json",
 "preview": "https://stashui.vercel.app/c/DecryptedText-TS-TW",
 "dupe_group": null,
 "alternatives": [],
 "blurb": "Text animates from encrypted gibberish to readable, triggered by hover, scroll…",
 "description": "Renders text as scrambled characters and progressively reveals the readable text character by character or randomly. Trigger modes: hover, scroll visibility, or click; can reverse back to encrypted.",
 "use_when": "A reveal animation that wants to intrigue or disguise content until the user interacts.",
 "avoid_when": "When the content must be immediately readable for SEO or accessibility compliance.",
 "a11y": "Encrypted text is shown visually but hidden with aria-hidden; readable text is in sr-only for screen readers. Works correctly when decrypted.",
