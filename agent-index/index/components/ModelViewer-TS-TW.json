 "dupe_group": null,
 "alternatives": [],
 "blurb": "3D model viewer with drag rotation, parallax, and configurable lighting using…",
 "description": "Renders GLB, GLTF, FBX, or OBJ models in an interactive 3D canvas. Supports drag-to-rotate, mouse parallax, auto-rotation, and pinch-zoom on touch. Includes environment presets and shadow support.",
 "use_when": "Showcasing 3D assets, product models, or interactive visualizations that benefit from real-time rotation and lighting…",
 "avoid_when": "Touch-only devices without proper gesture support, or when model formats like GLTF need complex post-processing beyond…",
 "a11y": "Primarily visual. Screenshot button is keyboard-accessible. No focus indicators on the model itself. Parallax motion cannot be disabled.",
