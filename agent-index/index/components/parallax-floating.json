 "usage": "\"use client\"\n\nimport { useEffect } from \"react\"\nimport { motion, stagger, useAnimate } from \"motion/react\"\n\nimport Floating, { FloatingElement } from \"./parallax-floating\"\n\nconst exampleImages = [\n  { url: \"https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1548192746-dd526f154ed9?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1460999158988-6f0380f81f4d?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1517849845537-4d257902454a?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1618220649687-ba860f3176e7?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1572851899646-a1f69c664e1e?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1518599904199-0ca897819ddb?w=600&q=80\" },\n  { url: \"https://images.unsplash.com/photo-1584043204475-8cc101d6c77a?w=600&q=80\" },\n]\n\nconst ParallaxFloatingDemo = () => {\n  const [scope, animate] = useAnimate()\n\n  useEffect(() => {\n    animate(\"img\", { opacity: [0, 1] }, { duration: 0.5, delay: stagger(0.15) })\n  }, [animate])\n\n  return (\n    <div\n      className=\"relative flex h-[640px] w-full justify-center items-center bg-background overflow-hidden\"\n      ref={scope}\n    >\n      <motion.div\n        className=\"z-50 text-center space-y-4 items-center flex flex-col\"\n        initial={{ opacity: 0, y: 10 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.88, delay: 1.5 }}\n      >\n        <p className=\"text-5xl md:text-7xl z-50 text-foreground font-serif italic\">\n          stash.\n        </p>\n        <p className=\"text-xs z-50 hover:scale-110 transition-transform bg-foreground text-background rounded-full py-2 w-20 cursor-pointer\">\n          Download\n        </p>\n      </motion.div>\n\n      <Floating sensitivity={-1} className=\"overflow-hidden\">\n        <FloatingElement depth={0.5} className=\"top-[8%] left-[11%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 1\"\n            src={exampleImages[0].url}\n            className=\"w-16 h-16 md:w-24 md:h-24 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n        <FloatingElement depth={1} className=\"top-[10%] left-[32%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 2\"\n            src={exampleImages[1].url}\n            className=\"w-20 h-20 md:w-28 md:h-28 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n        <FloatingElement depth={2} className=\"top-[2%] left-[53%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 3\"\n            src={exampleImages[2].url}\n            className=\"w-28 h-40 md:w-40 md:h-52 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n        <FloatingElement depth={1} className=\"top-[0%] left-[83%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 4\"\n            src={exampleImages[3].url}\n            className=\"w-24 h-24 md:w-32 md:h-32 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n\n        <FloatingElement depth={1} className=\"top-[40%] left-[2%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 5\"\n            src={exampleImages[4].url}\n            className=\"w-28 h-28 md:w-36 md:h-36 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n        <FloatingElement depth={2} className=\"top-[70%] left-[77%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 6\"\n            src={exampleImages[7].url}\n            className=\"w-28 h-28 md:w-36 md:h-48 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n\n        <FloatingElement depth={4} className=\"top-[73%] left-[15%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 7\"\n            src={exampleImages[5].url}\n            className=\"w-40 md:w-52 h-full object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n        <FloatingElement depth={1} className=\"top-[80%] left-[50%]\">\n          <motion.img\n            initial={{ opacity: 0 }}\n            alt=\"Gallery photo 8\"\n            src={exampleImages[6].url}\n            className=\"w-24 h-24 md:w-32 md:h-32 object-cover hover:scale-105 duration-200 cursor-pointer transition-transform\"\n          />\n        </FloatingElement>\n      </Floating>\n    </div>\n  )\n}\n\nexport default ParallaxFloatingDemo",
