   "type": "number",
   "default": null,
   "required": false
  },
  {
   "name": "brightness",
   "type": "number",
   "default": null,
   "required": false
  },
  {
   "name": "blur",
   "type": "number | string",
   "default": null,
   "required": false
  },
  {
   "name": "opacity",
   "type": "number",
   "default": null,
   "required": false
  },
  {
   "name": "rounded",
   "type": "boolean | string",
   "default": "true",
   "required": false
  },
  {
   "name": "invertOnDark",
   "type": "boolean",
   "default": "false",
   "required": false
  }
 ],
 "traits": {
